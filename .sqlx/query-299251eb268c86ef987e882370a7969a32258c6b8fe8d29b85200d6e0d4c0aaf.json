  "query": "INSERT INTO users (id, google_sub, email, display_name)\n         VALUES ($1, $2, $3, $4)\n         ON CONFLICT (google_sub)\n         DO UPDATE SET email = EXCLUDED.email, display_name = EXCLUDED.display_name\n         RETURNING id, google_sub, email, display_name",
