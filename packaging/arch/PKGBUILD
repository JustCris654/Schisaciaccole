# Maintainer: Cristian Scapin <cristian.scapin@openmove.com>
#
# Local PKGBUILD: builds the working tree two levels up (the repo root).
# Run it from THIS directory so makepkg's src/ and pkg/ dirs stay here and
# never collide with the crates' own src/ dirs:
#
#     cd packaging/arch
#     makepkg -f
#     sudo pacman -U schisaciaccole-*.pkg.tar.zst
#
pkgname=schisaciaccole
pkgver=1.0.0
pkgrel=1
pkgdesc="Countdown timer for time-boxed Scrum ceremonies"
arch=('x86_64')
url="https://github.com/JustCris654/schisaciaccole"
license=('PolyForm-Noncommercial-1.0.0')
depends=('alsa-lib' 'fontconfig' 'libxkbcommon')
makedepends=('cargo')
options=('!lto' '!debug')

# Resolve the repo root relative to this PKGBUILD.
_projroot="$(realpath "$startdir/../..")"

prepare() {
  # Copy only the needed sources into a clean build dir under $srcdir.
  # Building here (not in $_projroot) keeps cargo's build-script fingerprint
  # scan away from makepkg's pkg/ dir, which it cannot read.
  local b="$srcdir/$pkgname"
  rm -rf "$b"
  mkdir -p "$b"
  cp -a "$_projroot"/{Cargo.toml,Cargo.lock,crates} "$b/"

  cd "$b"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --frozen -p "$pkgname"
}

package() {
  local assets="$srcdir/$pkgname/crates/app/assets"
  local sound=level_up_no_copyright.mp3

  install -Dm755 "$srcdir/target/release/$pkgname"  "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "$assets/$sound"              "$pkgdir/usr/lib/$pkgname/assets/$sound"
  install -Dm644 "$assets/icon_128.png"        "$pkgdir/usr/share/icons/hicolor/128x128/apps/$pkgname.png"
  install -Dm644 "$assets/icon_256.png"        "$pkgdir/usr/share/icons/hicolor/256x256/apps/$pkgname.png"
  install -Dm644 "$assets/icon_512.png"        "$pkgdir/usr/share/icons/hicolor/512x512/apps/$pkgname.png"
  install -Dm644 "$startdir/$pkgname.desktop"  "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 "$_projroot/LICENSE"          "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
