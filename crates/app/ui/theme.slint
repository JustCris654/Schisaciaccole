    viewbox-width: 24;
    viewbox-height: 24;
    fill: root.tint;
    commands: "M7 5H17A2 2 0 0 1 19 7V17A2 2 0 0 1 17 19H7A2 2 0 0 1 5 17V7A2 2 0 0 1 7 5z";
}

export component HomeIcon inherits Path {
    in property <color> tint: AppTheme.text-brand;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.tint;
    stroke-width: 2.2 * self.width / 24;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: "M3 11.5L12 4l9 7.5 M5 10v10h5v-6h4v6h5V10";
