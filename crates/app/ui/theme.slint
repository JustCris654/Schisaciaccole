import { Palette, ScrollView } from "std-widgets.slint";

export global AppTheme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> background: dark ? #17171b : #f4f1ec;
    out property <color> panel: dark ? #222228 : #fcfaf7;
    out property <color> text: dark ? #f5f3f7 : #211b29;
    out property <color> muted: dark ? #aaa5b2 : #686071;
    out property <color> tint: dark ? #352a40 : #f0e5fa;
    out property <color> line: dark ? #414149 : #d7d0df;
    out property <color> accent: dark ? #c682f5 : #7734ad;
    out property <color> on-accent: dark ? #17171b : #ffffff;
    out property <length> corner-radius: 8px;
    out property <length> control-height: 44px;
    out property <length> spacing: 8px;
}

export global AppMotion {
    in-out property <bool> reduced: true;
}

export component MotionProgress {
    in property <duration> duration: 1ms;
    in property <bool> reduced: AppMotion.reduced;
    out property <bool> active;
    private property <duration> started;
    // Settled transitions stop reading the animation clock and requesting frames.
    out property <float> value: !root.active || root.reduced ? 1
        : clamp((animation-tick() - root.started) / max(root.duration, 1ms), 0, 1);

    public function restart() {
        if (root.reduced) {
            root.active = false;
        } else {
            root.started = animation-tick();
            root.active = true;
        }
    }
    public function finish() { root.active = false; }

    changed value => {
        if (root.value >= 1) { root.active = false; }
    }
    changed reduced => {
        if (root.reduced) { root.finish(); }
    }
}

export component AppText inherits Text {
    color: AppTheme.text;
    font-size: 14px;
}

export component ThemedButton inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <length> font-size: 14px;
    in property <bool> primary;
    in property <color> foreground: root.primary ? AppTheme.on-accent : AppTheme.text;
    in property <bool> compact;
    in property <bool> bare;
    in property <bool> checkable;
    in property <bool> checked;
    in property <string> accessible-name;
    in property <bool> enabled: true;
    out property <bool> has-focus: focus.has-focus;
    out property <bool> hovered: touch.has-hover;
    callback clicked();
    in property <color> base-background: root.primary ? AppTheme.accent : (root.bare ? transparent : AppTheme.panel);
    in property <color> hover-background: root.primary ? AppTheme.accent.darker(0.08) : AppTheme.background;
    private property <color> target-fill: touch.pressed
        ? (root.primary ? AppTheme.accent.darker(0.16) : AppTheme.line)
        : (touch.has-hover ? root.hover-background : root.base-background);
    private property <color> from-fill;
    private property <color> to-fill;
    private property <color> displayed-fill: root.to-fill.mix(root.from-fill, hover-fade.value);

    init => {
        root.from-fill = root.target-fill;
        root.to-fill = root.target-fill;
    }
    changed target-fill => {
        let previous = root.displayed-fill;
        root.from-fill = previous;
        root.to-fill = root.target-fill;
        if (previous != root.to-fill) { hover-fade.restart(); }
    }

    hover-fade := MotionProgress { duration: 120ms; }

    forward-focus: focus;
    min-width: content.min-width;
    height: max(content.min-height, root.compact ? 28px : AppTheme.control-height);
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: AppTheme.corner-radius;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus
        ? (root.primary ? AppTheme.text : AppTheme.accent)
        : (root.primary || root.bare ? transparent : AppTheme.line);
    opacity: root.enabled ? 1 : 0.45;
    background: root.displayed-fill;

    accessible-role: button;
    accessible-label: root.accessible-name == "" ? root.text : root.accessible-name;
    accessible-checkable: root.checkable;
    accessible-checked: root.checked;
    accessible-description: root.detail;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    content := VerticalLayout {
        padding-left: root.compact ? 6px : 16px;
        padding-right: root.compact ? 6px : 16px;
        padding-top: root.compact ? 2px : 8px;
        padding-bottom: root.compact ? 2px : 8px;
        spacing: AppTheme.spacing;
        alignment: center;

        AppText {
            text: root.text;
            font-size: root.font-size;
            font-weight: 700;
            color: root.foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }

        if root.detail != "" : AppText {
            text: root.detail;
            font-size: 13px;
            color: root.primary ? AppTheme.on-accent : AppTheme.muted;
            horizontal-alignment: center;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }

    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (!root.enabled) { return reject; }
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

export component CompactButton inherits VerticalLayout {
    in property <string> text <=> control.text;
    in property <string> accessible-name <=> control.accessible-name;
    in property <bool> enabled <=> control.enabled;
    in property <bool> bare <=> control.bare;
    in property <bool> primary <=> control.primary;
    in property <color> foreground <=> control.foreground;
    callback clicked <=> control.clicked;
    forward-focus: control;
    alignment: center;
    horizontal-stretch: 0;

    control := ThemedButton { compact: true; }
}
