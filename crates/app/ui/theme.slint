    in property <color> tint: #FFFFFF;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: root.tint;
    commands: "M1.9 12a2.6 2.6 0 1 0 5.2 0a2.6 2.6 0 1 0-5.2 0z M9.4 12a2.6 2.6 0 1 0 5.2 0a2.6 2.6 0 1 0-5.2 0z M16.9 12a2.6 2.6 0 1 0 5.2 0a2.6 2.6 0 1 0-5.2 0z";
}

export component StopIcon inherits Path {
