export component LogoutIcon inherits Path {
    in property <color> tint: AppTheme.text;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.tint;
    stroke-width: 2.25 * self.width / 24;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: "M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4 M16 17l5-5-5-5 M21 12H9";
}

// Speech bubble with a clock. `bubble` and `hands` swap for light and brand backgrounds.
export component LogoMark inherits Rectangle {
    in property <color> bubble: #FFFFFF;
    in property <color> hands: AppTheme.brand;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 40;
        viewbox-height: 40;
        fill: AppTheme.orange;
        commands: "M17.5 3H22.5A1.5 1.5 0 0 1 24 4.5V6.5A1.5 1.5 0 0 1 22.5 8H17.5A1.5 1.5 0 0 1 16 6.5V4.5A1.5 1.5 0 0 1 17.5 3z";
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 40;
        viewbox-height: 40;
        fill: root.bubble;
        commands: "M14 8.5h12a11 11 0 0 1 0 22h-9.5l-6.2 5.3c-0.7 0.6-1.7 0-1.5-0.9l1.2-5.6A11 11 0 0 1 14 8.5z";
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 40;
        viewbox-height: 40;
        stroke: root.hands;
        stroke-width: 2.6 * self.width / 40;
        stroke-line-cap: round;
        commands: "M20 19.5V13.5M20 19.5l4.5 2.6";
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 40;
        viewbox-height: 40;
        fill: root.hands;
        commands: "M18 19.5a2 2 0 1 0 4 0a2 2 0 1 0-4 0z";
    }
}

export enum PillKind { primary, ghost, outline, link }

// Fully rounded button. Children (an icon) are placed before the label.
export component PillButton inherits Rectangle {
    in property <string> text;
    in property <PillKind> kind: PillKind.primary;
    in property <bool> enabled: true;
    // Small variant of the outline kind used by the countdown screens.
    in property <bool> compact;
    in property <string> accessible-name;
    out property <bool> has-focus: focus.has-focus;
    out property <color> foreground: root.kind == PillKind.primary ? AppTheme.on-brand
        : (root.kind == PillKind.outline ? AppTheme.text-brand
            : (root.kind == PillKind.link && !touch.has-hover ? AppTheme.text-secondary : AppTheme.text));
    callback clicked();
    private property <bool> link: root.kind == PillKind.link;
    private property <color> fill-color: root.kind == PillKind.primary
        ? (touch.pressed ? AppTheme.brand.darker(0.12) : (touch.has-hover ? AppTheme.brand.brighter(0.08) : AppTheme.brand))
        : (touch.pressed ? AppTheme.border-subtle
            : (touch.has-hover ? AppTheme.surface
                : (root.link ? AppTheme.surface.transparentize(1) : AppTheme.page)));

    forward-focus: focus;
    preferred-width: content.preferred-width;
    preferred-height: root.outline && root.compact ? 28px : content.preferred-height;
    min-width: content.min-width;
    min-height: root.outline && root.compact ? 28px : content.min-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    opacity: root.enabled ? 1 : 0.4;

    accessible-role: button;
    accessible-label: root.accessible-name == "" ? root.text : root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    FadeFill {
        width: parent.width;
        height: parent.height;
        border-radius: self.height / 2;
        target: root.fill-color;
    }
    if root.kind == PillKind.ghost || root.kind == PillKind.outline : Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: self.height / 2;
        border-width: 2px;
        border-color: AppTheme.border-subtle;
    }

    private property <bool> outline: root.kind == PillKind.outline;
    content := HorizontalLayout {
        padding-left: root.link ? 14px : (root.outline ? (root.compact ? 10px : 18px) : 28px);
        padding-right: root.link ? 14px : (root.outline ? (root.compact ? 10px : 18px) : 28px);
        padding-top: root.link ? 10px : (root.outline ? (root.compact ? 0px : 8px) : 14px);
        padding-bottom: root.link ? 10px : (root.outline ? (root.compact ? 0px : 8px) : 14px);
        spacing: root.outline && root.compact ? 5px : (root.outline ? 8px : 10px);
        alignment: center;
        VerticalLayout {
            alignment: center;
            @children
        }
        Text {
            text: root.text;
            font-size: root.link ? 15px : (root.outline ? (root.compact ? 11px : 14px) : 17px);
            font-weight: root.link ? 600 : 700;
            color: root.foreground;
            vertical-alignment: center;
            horizontal-alignment: center;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (!root.enabled) { return reject; }
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    if focus.has-focus : FocusRing { host-width: root.width; host-height: root.height; corner-radius: root.height / 2; }
}
