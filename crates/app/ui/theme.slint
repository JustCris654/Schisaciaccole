import { Palette } from "std-widgets.slint";

export global AppTheme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> page: dark ? #17141D : #FFFFFF;
    out property <color> surface: dark ? #262033 : #F1ECFA;
    out property <color> brand: #6B2FBF;
    out property <color> on-brand: #FFFFFF;
    out property <color> text: dark ? #F3EFF9 : #1E1A26;
    out property <color> text-secondary: dark ? #A79FB8 : #6A6378;
    out property <color> text-brand: dark ? #B892F5 : #6B2FBF;
    out property <color> border-subtle: dark ? #3D3350 : #DCD0F2;
    out property <color> orange: dark ? #F29A2E : #E07B00;
    out property <color> orange-soft: dark ? #33250F : #FDF1E1;
    out property <color> orange-tint: dark ? #5C3F14 : #F8D7A8;
    // Orange dark enough to read as text on the page background.
    out property <color> notice: dark ? #F29A2E : #A85A00;
    out property <color> danger: dark ? #3D3350 : #1E1A26;
    out property <color> on-danger: #FFFFFF;
    out property <color> nav-tab-text: #FFFFFFCC;
    out property <color> nav-tab-hover: #FFFFFF29;
    out property <color> nav-icon-hover: #FFFFFF24;
    out property <color> nav-selected: #FFFFFF;
    out property <color> nav-selected-hover: #F1ECFA;
    out property <length> radius-card: 18px;
    out property <length> radius-item: 12px;
}

export global AppMotion {
    in-out property <bool> reduced: true;
}

export component MotionProgress {
    in property <duration> duration: 1ms;
    in property <bool> reduced: AppMotion.reduced;
    out property <bool> active;
    private property <duration> started;
    // Settled transitions stop reading the animation clock and requesting frames.
    out property <float> value: !root.active || root.reduced ? 1
        : clamp((animation-tick() - root.started) / max(root.duration, 1ms), 0, 1);

    public function restart() {
        if (root.reduced) {
            root.active = false;
        } else {
            root.started = animation-tick();
            root.active = true;
        }
    }
    public function finish() { root.active = false; }

    changed value => {
        if (root.value >= 1) { root.active = false; }
    }
    changed reduced => {
        if (root.reduced) { root.finish(); }
    }
}

// Background that fades to `target` whenever it changes, unless motion is reduced.
export component FadeFill inherits Rectangle {
    in property <color> target;
    private property <color> from-fill;
    private property <color> to-fill;
    private property <color> displayed-fill: root.to-fill.mix(root.from-fill, fade.value);

    init => {
        root.from-fill = root.target;
        root.to-fill = root.target;
    }
    changed target => {
        let previous = root.displayed-fill;
        root.from-fill = previous;
        root.to-fill = root.target;
        if (previous != root.to-fill) { fade.restart(); }
    }

    fade := MotionProgress { duration: 120ms; }
    background: root.displayed-fill;
}

// Keyboard focus ring: 3px orange, 2px away from the parent.
export component FocusRing inherits Rectangle {
    in property <length> host-width;
    in property <length> host-height;
    in property <length> corner-radius;
    x: -5px;
    y: -5px;
    width: root.host-width + 10px;
    height: root.host-height + 10px;
    border-radius: root.corner-radius + 5px;
    border-width: 3px;
    border-color: AppTheme.orange;
}

export component AppText inherits Text {
    color: AppTheme.text;
    font-size: 14px;
}

export component PageTitle inherits Text {
    color: AppTheme.text;
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -0.68px;
    overflow: elide;
}

export component PageSub inherits Text {
    color: AppTheme.text-secondary;
    font-size: 19px;
}

export component PlayIcon inherits Path {
    in property <color> tint: AppTheme.on-brand;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: root.tint;
    commands: "M7 4.5v15a1 1 0 0 0 1.52 0.86l12-7.5a1 1 0 0 0 0-1.72l-12-7.5A1 1 0 0 0 7 4.5z";
}

export component HelpIcon inherits Rectangle {
    in property <color> tint: #FFFFFF;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.tint;
        stroke-width: 2.4 * self.width / 24;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: "M2 12a10 10 0 1 0 20 0a10 10 0 1 0-20 0z M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3";
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.tint;
        commands: "M11.4 17a0.6 0.6 0 1 0 1.2 0a0.6 0.6 0 1 0-1.2 0z";
    }
}

