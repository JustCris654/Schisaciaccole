import { ListView, AboutSlint } from "std-widgets.slint";
import { AppTheme, AppText, ThemedButton, CompactButton, ThemedField, ScrollList, AppMotion, MotionProgress } from "theme.slint";

import "../assets/fonts/Plus_Jakarta_Sans/static/PlusJakartaSans-Regular.ttf";
import "../assets/fonts/Plus_Jakarta_Sans/static/PlusJakartaSans-Medium.ttf";
import "../assets/fonts/Plus_Jakarta_Sans/static/PlusJakartaSans-Bold.ttf";

export enum Page { SelectionPage, TimerPage, TimerFinished, LoadingPage, LoginPage, MeetingsPage, EditorPage }
export enum StopType { TimerFinished, UserStopped }

export struct TimeOption { time: string, minutes: string }
export struct MeetingRow {
    time-range: string,
    title: string,
    attendees: string,
    in-progress: bool,
    has-template: bool,
}
export struct EditorRow {
    label: string,
    minutes: int,
    included: bool,
    attendee: bool,
    email: string,
}

component Heading inherits AppText {
    font-size: 28px;
    font-weight: 700;
    overflow: elide;
}

component MutedText inherits AppText { color: AppTheme.muted; }

component Navigation inherits HorizontalLayout {
    in property <bool> meetings-page;
    in property <bool> signed-in;
    callback free-slots();
    callback meetings();
    callback logout();
    callback help();
    spacing: 8px;
    height: 44px;

    ThemedButton {
        width: 150px;
        text: "Orari liberi";
        primary: !root.meetings-page;
        clicked => { root.free-slots(); }
    }
    ThemedButton {
        width: 150px;
        text: "I miei meeting";
        primary: root.meetings-page;
        enabled: root.signed-in;
        clicked => { root.meetings(); }
    }
    Rectangle { horizontal-stretch: 1; }
    if root.signed-in : CompactButton {
        text: "Esci";
        bare: true;
        clicked => { root.logout(); }
    }
    CompactButton {
        text: "?";
        accessible-name: "Scorciatoie da tastiera";
        bare: true;
        clicked => { root.help(); }
    }
}

component MeetingsPage {
    in property <string> account-name;
    in property <[MeetingRow]> meetings;
    in property <bool> loading;
    in property <string> error;
    callback select(int);
    callback open-editor(int);
    callback refresh();
    callback logout();
    callback free-slots();
    callback help();

    init => { root.refresh(); }
    Timer { interval: 60s; running: true; triggered => { root.refresh(); } }

    VerticalLayout {
        padding: 32px;
        spacing: 24px;
        Navigation {
            meetings-page: true;
            signed-in: true;
            free-slots => { root.free-slots(); }
            meetings => { root.refresh(); }
            logout => { root.logout(); }
            help => { root.help(); }
        }
        Heading { text: "I meeting di oggi"; }
        MutedText { text: "Google Calendar · " + root.account-name; overflow: elide; }
        if root.loading : MutedText { text: "Caricamento…"; }
        if root.error != "" : AppText {
            text: root.error;
            color: AppTheme.accent;
            wrap: word-wrap;
        }
        if !root.loading && root.error == "" && root.meetings.length == 0 : MutedText {
            text: "Nessun altro meeting oggi.";
        }
        meeting-list := ListView {
            vertical-stretch: 1;
            for row[index] in root.meetings : Rectangle {
                height: index == root.meetings.length - 1 ? 78px : 102px;
                Rectangle {
                    y: 0px;
                    height: 78px;
                    border-radius: 10px;
                    background: row.in-progress ? AppTheme.tint : AppTheme.background;
                    HorizontalLayout {
                        padding: 16px;
                        spacing: 20px;
                        AppText {
                            text: row.time-range;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            spacing: 5px;
                            alignment: center;
                            horizontal-stretch: 1;
                            AppText {
                                text: row.title;
                                font-size: 17px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            MutedText {
                                text: (row.in-progress ? "In corso · " : "") + row.attendees + (row.has-template ? " · slot salvati" : "");
                                font-size: 12px;
                                overflow: elide;
                            }
                        }
                        ThemedButton {
                            text: "Editor";
                            clicked => { root.open-editor(index); }
                        }
                        if row.in-progress : ThemedButton {
                            text: "Avvia";
                            primary: true;
                            clicked => { root.select(index); }
                        }
                    }
                }
            }
        }
    }
}

component EditorPage {
    in property <string> title;
    in property <string> time-range;
    in property <string> duration;
    in property <bool> attendees-warning;
    in property <bool> loading;
    in property <bool> busy;
    in property <string> notice;
    in property <string> unassigned;
    in property <bool> over;
    in property <bool> has-template;
    in property <[EditorRow]> rows;
    callback set-label(int, string);
    callback set-minutes(int, int);
    callback set-included(int, bool);
    callback move-up(int);
    callback move-down(int);
    callback remove-row(int);
    callback add-row();
    callback reset();
    callback save();
    callback delete-template();
    callback start-meeting();
    callback back();

    VerticalLayout {
        padding: 24px;
        spacing: 8px;
        Heading { text: "Organizza i turni"; }
        MutedText {
            text: root.title + " · " + root.time-range + " · " + root.duration;
            overflow: elide;
        }
        if root.attendees-warning : AppText {
            text: "Lista partecipanti incompleta: aggiungi le voci mancanti";
            color: AppTheme.accent;
            font-size: 12px;
            wrap: word-wrap;
        }
        if root.loading : MutedText { text: "Caricamento…"; vertical-stretch: 1; }
        if !root.loading : ScrollList {
            vertical-stretch: 1;
            for row[index] in root.rows : Rectangle {
                height: 56px;
                Rectangle {
                    height: 52px;
                    border-radius: 8px;
                    background: AppTheme.background;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 4px;
                        CompactButton {
                            text: "↑";
                            accessible-name: "Sposta su " + row.label;
                            bare: true;
                            enabled: index > 0;
                            clicked => { root.move-up(index); }
                        }
                        CompactButton {
                            text: "↓";
                            accessible-name: "Sposta giù " + row.label;
                            bare: true;
                            enabled: index < root.rows.length - 1;
                            clicked => { root.move-down(index); }
                        }
                        if row.attendee : VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            ThemedButton {
                                compact: true;
                                accessible-role: checkbox;
                                text: row.included ? "☑" : "☐";
                                accessible-name: "Includi " + row.label;
                                bare: true;
                                checkable: true;
                                checked: row.included;
                                clicked => { root.set-included(index, !row.included); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            ThemedField {
                                text <=> row.label;
                                accessible-name: "Nome del turno " + (index + 1);
                                opacity: row.included ? 1 : 0.6;
                                edited(text) => { root.set-label(index, text); }
                            }
                            if row.attendee && row.email != "" : MutedText {
                                text: row.email;
                                font-size: 9px;
                                overflow: elide;
                            }
                        }
                        if !row.attendee : CompactButton {
                            text: "×";
                            accessible-name: "Rimuovi " + row.label;
                            bare: true;
                            clicked => { root.remove-row(index); }
                        }
                        CompactButton {
                            text: "−";
                            accessible-name: "Riduci minuti di " + row.label;
                            bare: true;
                            enabled: row.minutes > 0;
                            clicked => { root.set-minutes(index, row.minutes - 1); }
                        }
                        ThemedField {
                            width: 44px;
                            text: row.minutes;
                            committed-text: row.minutes;
                            accessible-name: "Minuti di " + row.label;
                            numeric: true;
                            font-weight: 400;
                            horizontal-alignment: center;
                            edited(text) => {
                                if (text.is-float()) { root.set-minutes(index, round(text.to-float())); }
                            }
                        }
                        AppText { text: "min"; vertical-alignment: center; }
                        CompactButton {
                            text: "+";
                            foreground: #ffffff;
                            accessible-name: "Aumenta minuti di " + row.label;
                            primary: true;
                            enabled: row.minutes < 600;
                            clicked => { root.set-minutes(index, row.minutes + 1); }
                        }
                    }
                }
            }
        }
        if root.notice != "" : AppText {
            text: root.notice;
            color: AppTheme.accent;
            font-size: 12px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            AppText {
                text: root.unassigned;
                color: root.over ? AppTheme.accent : AppTheme.muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            CompactButton {
                text: "+ Aggiungi voce";
                bare: true;
                enabled: !root.loading;
                clicked => { root.add-row(); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            CompactButton {
                text: "←";
                accessible-name: "Indietro";
                bare: true;
                clicked => { root.back(); }
            }
            CompactButton {
                text: "Slot uguali";
                accessible-name: "Ripristina slot uguali";
                bare: true;
                enabled: !root.loading;
                clicked => { root.reset(); }
            }
            if root.has-template : CompactButton {
                text: "Elimina preferenza";
                bare: true;
                enabled: !root.loading && !root.busy;
                clicked => { root.delete-template(); }
            }
            Rectangle { horizontal-stretch: 1; }
            ThemedButton {
                text: "Salva preferenza";
                width: 180px;
                enabled: !root.loading && !root.busy;
                clicked => { root.save(); }
            }
            ThemedButton {
                text: "Avvia";
                width: 96px;
                primary: true;
                enabled: !root.loading;
                clicked => { root.start-meeting(); }
            }
        }
    }
}

component SpeakerName inherits Rectangle {
    in property <string> name;
    in property <int> identity: -1;
    private property <string> remembered-name;
    private property <string> previous-name;
    private property <int> previous-identity: -1;
    min-height: speaker-content.preferred-height;
    horizontal-stretch: 1;

    init => {
        root.remembered-name = root.name;
        root.previous-identity = root.identity;
    }
    changed name => {
        if (root.identity == root.previous-identity) {
            root.remembered-name = root.name;
        }
    }
    changed identity => {
        if (root.identity != root.previous-identity) {
            root.previous-name = root.remembered-name;
            root.remembered-name = root.name;
            if (root.previous-identity >= 0 && root.identity >= 0) {
                speaker-fade.restart();
            } else {
                speaker-fade.finish();
            }
            root.previous-identity = root.identity;
        }
    }
    speaker-fade := MotionProgress { duration: 220ms; }
    speaker-previous := AppText {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        text: root.previous-name;
        font-size: 24px;
        font-weight: 700;
        overflow: elide;
        opacity: 1 - speaker-fade.value;
        accessible-role: none;
    }
    speaker-content := AppText {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        text: root.name;
        font-size: 24px;
        font-weight: 700;
        overflow: elide;
        opacity: speaker-fade.value;
    }
}

component TimerPage {
    in property <duration> timer-time;
    in property <bool> running-state;
    in property <string> meeting-title;
    in property <string> timer-end;
    in property <float> progress;
    in property <bool> has-slots;
    in property <string> slot-name;
    in property <int> slot-identity;
    in property <duration> slot-time;
    in property <string> next-slot-name;
    in property <bool> slots-warning;
    in property <bool> plan-loading;
    in property <bool> plan-warning;
    callback stop(StopType);
    callback tick();
    callback next-slot();

    Timer {
        interval: 0.25s;
        running: root.running-state;
        triggered => { if (root.running-state) { root.tick(); } }
    }
    pure function duration-text(value: duration) -> string {
        let total = max(0, ceil(value / 1s));
        let hours = floor(total / 3600);
        let minutes = mod(floor(total / 60), 60);
        let seconds = mod(total, 60);
        return (hours > 0 ? (hours < 10 ? "0" : "") + hours + ":" : "")
            + (minutes < 10 ? "0" : "") + minutes + ":"
            + (seconds < 10 ? "0" : "") + seconds;
    }

    if root.meeting-title == "" : VerticalLayout {
        padding: 32px;
        spacing: 40px;
        alignment: center;
        AppText {
            text: root.duration-text(root.timer-time);
            color: AppTheme.accent;
            font-size: min(144px, root.width / (root.timer-time >= 3600s ? 7.5 : 5.4));
            font-weight: 700;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            ThemedButton {
                text: "Stop";
                width: AppTheme.dark ? 200px : 112px;
                clicked => { root.stop(StopType.UserStopped); }
            }
        }
    }

    if root.meeting-title != "" : VerticalLayout {
        padding: 32px;
        spacing: root.plan-loading || root.plan-warning || root.slots-warning ? 8px : 16px;
        alignment: center;
        AppText {
            text: root.meeting-title;
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
            overflow: elide;
        }
        MutedText { text: "Termina alle " + root.timer-end; horizontal-alignment: center; }
        AppText {
            text: root.duration-text(root.timer-time);
            color: AppTheme.accent;
            font-size: min(110px, root.width / (root.timer-time >= 3600s ? 7.5 : 5.4));
            font-weight: 700;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: min(680px, root.width - 64px);
                height: 6px;
                border-radius: 3px;
                background: AppTheme.line;
                progress-fill := Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width * clamp(root.progress, 0, 1);
                    height: parent.height;
                    border-radius: 3px;
                    background: AppTheme.accent;
                }
            }
        }
        if root.has-slots : HorizontalLayout {
            alignment: center;
            Rectangle {
                width: min(680px, root.width - 64px);
                height: 88px;
                border-radius: 12px;
                background: AppTheme.tint;
                HorizontalLayout {
                    padding: 16px;
                    spacing: 32px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;
                        AppText { text: "STA PARLANDO"; color: AppTheme.accent; font-size: 11px; }
                        SpeakerName { name: root.slot-name; identity: root.slot-identity; }
                    }
                    AppText {
                        text: root.duration-text(root.slot-time);
                        font-size: 24px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }
        if root.has-slots && root.next-slot-name != "" : MutedText {
            text: "Poi: " + root.next-slot-name;
            horizontal-alignment: center;
            overflow: elide;
        }
        if root.plan-loading : MutedText { text: "Caricamento slot…"; horizontal-alignment: center; }
        if root.plan-warning || root.slots-warning : AppText {
            text: (root.plan-warning ? "Preferenza non caricata: slot uguali" : "")
                + (root.plan-warning && root.slots-warning ? " · " : "")
                + (root.slots-warning ? "Lista partecipanti incompleta" : "");
            font-size: 12px;
            color: AppTheme.accent;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: center;
            spacing: 20px;
            ThemedButton { text: "Stop"; width: 200px; clicked => { root.stop(StopType.UserStopped); } }
            if root.has-slots : ThemedButton {
                text: "Avanti →   N";
                width: 200px;
                primary: true;
                clicked => { root.next-slot(); }
            }
        }
    }
}
export component MainWindow inherits Window {
    title: "Schisaciaccole";
    background: AppTheme.panel;
    icon: @image-url("../assets/icon_256.png");
    preferred-width: 816px;
    min-width: 720px;
    preferred-height: 516px;
    min-height: 500px;
    default-font-family: "Plus Jakarta Sans";
    forward-focus: scope;

    property <bool> on-top: false;
    // Single-letter shortcuts are off on the editor page, where names are typed.
    property <bool> letter-keys-enabled: page != Page.EditorPage;

    always-on-top: on-top;

    in-out property <bool> reduce-motion <=> AppMotion.reduced;
    page-fade := MotionProgress { duration: 180ms; }
    finish-pulse := MotionProgress { duration: 600ms; }

    in property <string> current-time;
    in property <string> meeting-title;
    in property <string> timer-end;
    in property <float> timer-progress;
    in property <int> slot-identity: -1;

    in property     <duration> timer-time: 3s;
    in property     <bool>     running-state: false;
    in property     <Page>     page: SelectionPage; 
    in property     <[TimeOption]> options;
    in property     <bool>     is-macos;
    in property     <bool>     signed-in;
    in property     <string>   account-name;
    in property     <string>   notice;
    in property     <string>   login-status;
    in property     <bool>     login-waiting;
    in property     <[MeetingRow]> meetings;
    in property     <bool>     meetings-loading;
    in property     <string>   meetings-error;
    in property     <bool>     has-slots;
    in property     <string>   slot-name;
    in property     <duration> slot-time;
    in property     <string>   next-slot-name;
    in property     <bool>     slots-warning;
    in property     <bool>     plan-loading;
    in property     <bool>     plan-warning;
    in property     <[EditorRow]> editor-rows;
    in property     <string>   editor-title;
    in property     <string>   editor-time-range;
    in property     <string>   editor-duration;
    in property     <bool>     editor-attendees-warning;
    in property     <bool>     editor-loading;
    in property     <bool>     editor-busy;
    in property     <string>   editor-notice;
    in property     <string>   editor-unassigned;
    in property     <bool>     editor-over;
    in property     <bool>     editor-has-template;

    callback select-time(int);
    callback compute-options();
    callback tick();
    callback set-selection-page();
    callback quit();
    callback fullscreen(bool);
    callback help();
    callback stop(StopType);
    callback login();
    callback cancel-login();
    callback skip-login();
    callback select-meeting(int);
    callback refresh-meetings();
    callback set-meetings-page();
    callback close-finished();
    callback logout();
    callback next-slot();
    callback open-editor(int);
    callback editor-set-label(int, string);
    callback editor-set-minutes(int, int);
    callback editor-set-included(int, bool);
    callback editor-move-up(int);
    callback editor-move-down(int);
    callback editor-remove-row(int);
    callback editor-add-row();
    callback editor-reset();
    callback editor-save();
    callback editor-delete();
    callback editor-start();
    callback editor-back();

    // Leaving the editor drops its focused text field: give the focus back to the shortcuts.
    changed page => {
        page-fade.restart();
        if (page == Page.TimerFinished) { finish-pulse.restart(); }
        if (page != Page.EditorPage) {
            scope.focus();
        }
    }

    if is-macos: MenuBar {
	Menu {
	    title: @tr("Window");
	    MenuItem {
		title: @tr("Always on top");
		activated => { on-top = !on-top; }
		shortcut: @keys(Control + T);
	    }
	}
	Menu {
	    title: "Account";
	    if signed-in: MenuItem {
		title: "Esci dall'account";
		activated => { logout(); }
	    }
	}
    }

    scope := FocusScope {
        KeyBinding {
            keys: @keys(Q);
            enabled: root.letter-keys-enabled;
            activated => { quit(); }
        }

        KeyBinding {
            keys: @keys(M);
            enabled: root.letter-keys-enabled;
            activated => { fullscreen(false); }
        }

        KeyBinding {
            keys: @keys(Escape);
            activated => { fullscreen(true); }
        }

        KeyBinding {
            keys: @keys(T);
            enabled: root.letter-keys-enabled;
            activated => { on-top = !on-top; }
        }

        KeyBinding {
            keys: @keys(H);
            enabled: root.letter-keys-enabled;
            activated => { help(); }
        }

        KeyBinding {
            keys: @keys(N);
            enabled: root.letter-keys-enabled;
            activated => { next-slot(); }
        }
    }


    compute-options-timer := Timer {
	interval  : 3s;
	running: !running-state;
	
	triggered() => {
	    // when the main timer is stopped keep updating the selection
	    compute-options();
	}
    }


    page-body := Rectangle {
        width: root.width;
        height: root.height;
        opacity: page-fade.value;
        if page == Page.SelectionPage : VerticalLayout {
            padding: 32px;
            spacing: 24px;
            Navigation {
                signed-in: root.signed-in;
                free-slots => { root.set-selection-page(); }
                meetings => { root.set-meetings-page(); }
                logout => { root.logout(); }
                help => { root.help(); }
            }
            Heading { text: "Quando finisce la cerimonia?"; }
            MutedText {
                text: "Sono le " + root.current-time + ". Scegli l’orario di fine.";
                font-size: 16px;
            }
            GridLayout {
                height: 204px;
                spacing-horizontal: 16px;
                spacing-vertical: 24px;
                for option[index] in root.options : ThemedButton {
                    row: floor(index / 4);
                    col: mod(index, 4);
                    height: 90px;
                    horizontal-stretch: 1;
                    text: option.time;
                    detail: "tra " + option.minutes + " min";
                    font-size: 24px;
                    primary: index == 0;
                    base-background: index == 0 ? AppTheme.accent : AppTheme.background;
                    hover-background: index == 0 ? AppTheme.accent.darker(0.08) : AppTheme.tint;
                    border-width: self.has-focus ? 2px : 0px;
                    border-radius: 10px;
                    clicked => { root.select-time(index); }
                }
            }
            if root.notice != "" : AppText {
                text: root.notice;
                color: AppTheme.accent;
                font-size: 12px;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; }
        }

        if page == Page.MeetingsPage : MeetingsPage {
            width: root.width;
            height: root.height;
            account-name: root.account-name;
            meetings: root.meetings;
            loading: root.meetings-loading;
            error: root.meetings-error;
            select(index) => { root.select-meeting(index); }
            open-editor(index) => { root.open-editor(index); }
            refresh => { root.refresh-meetings(); }
            logout => { root.logout(); }
            free-slots => { root.set-selection-page(); }
            help => { root.help(); }
        }
        if page == Page.EditorPage : EditorPage {
            width: root.width;
            height: root.height;
            title: root.editor-title;
            time-range: root.editor-time-range;
            duration: root.editor-duration;
            attendees-warning: root.editor-attendees-warning;
            loading: root.editor-loading;
            busy: root.editor-busy;
            notice: root.editor-notice;
            unassigned: root.editor-unassigned;
            over: root.editor-over;
            has-template: root.editor-has-template;
            rows: root.editor-rows;
            set-label(index, text) => { root.editor-set-label(index, text); }
            set-minutes(index, value) => { root.editor-set-minutes(index, value); }
            set-included(index, included) => { root.editor-set-included(index, included); }
            move-up(index) => { root.editor-move-up(index); }
            move-down(index) => { root.editor-move-down(index); }
            remove-row(index) => { root.editor-remove-row(index); }
            add-row => { root.editor-add-row(); }
            reset => { root.editor-reset(); }
            save => { root.editor-save(); }
            delete-template => { root.editor-delete(); }
            start-meeting => { root.editor-start(); }
            back => { root.editor-back(); }
        }
        if page == Page.LoadingPage : VerticalLayout {
            padding: 32px;
            alignment: center;
            spacing: 16px;
            Heading { text: "Connessione…"; horizontal-alignment: center; }
            MutedText { text: "Prepariamo i tuoi meeting."; horizontal-alignment: center; }
        }
        if page == Page.LoginPage : VerticalLayout {
            padding: 48px;
            spacing: 24px;
            alignment: center;
            Heading { text: "Accedi con Google"; horizontal-alignment: center; color: AppTheme.accent; }
            MutedText {
                text: "I tuoi meeting di oggi, con un tempo per ogni voce.";
                font-size: 16px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: center;
                spacing: 16px;
                if !root.login-waiting : ThemedButton {
                    text: "Accedi con Google";
                    primary: true;
                    clicked => { root.login(); }
                }
                if !root.login-waiting : ThemedButton {
                    text: "Usa senza accesso";
                    clicked => { root.skip-login(); }
                }
                if root.login-waiting : ThemedButton { text: "Annulla"; clicked => { root.cancel-login(); } }
            }
            AppText {
                text: root.login-status;
                color: AppTheme.accent;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
        if page == Page.TimerPage : TimerPage {
            width: root.width;
            height: root.height;
            timer-time: root.timer-time;
            running-state: root.running-state;
            meeting-title: root.meeting-title;
            timer-end: root.timer-end;
            progress: root.timer-progress;
            has-slots: root.has-slots;
            slot-name: root.slot-name;
            slot-identity: root.slot-identity;
            slot-time: root.slot-time;
            next-slot-name: root.next-slot-name;
            slots-warning: root.slots-warning;
            plan-loading: root.plan-loading;
            plan-warning: root.plan-warning;
            next-slot => { root.next-slot(); }
            stop(stop-type) => { root.stop(stop-type); }
            tick => { root.tick(); }
        }
        if page == Page.TimerFinished : VerticalLayout {
            padding: 32px;
            spacing: 24px;
            alignment: center;
            finish-message := Heading {
                opacity: finish-pulse.active ? 1 - 0.08 * sin(180deg * finish-pulse.value) : 1;
                text: "Congrats!\nScrum ceremony finished";
                color: AppTheme.accent;
                horizontal-alignment: center;
            }
            AppText { text: "Now get the fuck outta here"; font-size: 24px; horizontal-alignment: center; }
            HorizontalLayout {
                alignment: center;
                ThemedButton { text: root.signed-in ? "Torna ai meeting" : "Torna agli orari"; clicked => { root.close-finished(); } }
            }
        }
    }
    if on-top : Rectangle {
        width: 8px;
        height: 8px;
        x: root.width - 12px;
        y: 4px;
        background: AppTheme.accent;
        border-radius: 4px;
    }
}

export component Help inherits Window {
    title: "Schisaciaccole · Scorciatoie";
    background: AppTheme.panel;
    preferred-width: 640px;
    preferred-height: 390px;
    min-width: 600px;
    min-height: 380px;
    always-on-top: true;
    default-font-family: "Plus Jakarta Sans";

    VerticalLayout {
        padding: 32px;
        spacing: 16px;
        Heading { text: "Scorciatoie da tastiera"; }
        GridLayout {
            spacing-horizontal: 24px;
            spacing-vertical: 12px;
            Row { AppText { text: "Q"; color: AppTheme.accent; } AppText { text: "Esci dall’app"; } }
            Row { AppText { text: "M"; color: AppTheme.accent; } AppText { text: "Attiva o disattiva lo schermo intero"; } }
            Row { AppText { text: "Esc"; color: AppTheme.accent; } AppText { text: "Esci dallo schermo intero"; } }
            Row { AppText { text: "T"; color: AppTheme.accent; } AppText { text: "Mantieni la finestra in primo piano"; } }
            Row { AppText { text: "H"; color: AppTheme.accent; } AppText { text: "Mostra le scorciatoie"; } }
            Row { AppText { text: "N"; color: AppTheme.accent; } AppText { text: "Passa al turno successivo"; } }
        }
        MutedText { text: "Le scorciatoie con lettere sono sospese nell’editor."; font-size: 12px; }
        AboutSlint { height: 50px; }
    }
}
