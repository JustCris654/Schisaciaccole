import { VerticalBox, HorizontalBox, AboutSlint, ListView, LineEdit, SpinBox, CheckBox } from "std-widgets.slint";

import { AppTheme, AppText, ThemedButton } from "theme.slint";

import "../assets/fonts/Plus_Jakarta_Sans/static/PlusJakartaSans-Medium.ttf";

export enum Page { SelectionPage, TimerPage, TimerFinished, LoadingPage, LoginPage, MeetingsPage, EditorPage }
export enum StopType { TimerFinished, UserStopped }

export struct TimeOption {
    time: string,
    minutes: string,
}

export struct MeetingRow {
    time-range: string,
    title: string,
    attendees: string,
    in-progress: bool,
    has-template: bool,
}

export struct EditorRow {
    label: string,
    minutes: int,
    included: bool,
    attendee: bool,
    email: string,
}

component SelectionButton inherits ThemedButton {
    in property <string> time;
    in property <string> minutes;
    text: root.time;
    detail: "Minutes: " + root.minutes;
    primary: true;
}

component AccentButton inherits ThemedButton {
    primary: true;
}

component AccountBar inherits HorizontalLayout {
    in property <string> account-name;
    in property <float> ui-scale;

    callback logout();

    spacing: 10px * ui-scale;

    AppText {
	text: "Connesso come " + root.account-name;
	font-size: 12px * root.ui-scale;
	vertical-alignment: center;
	horizontal-stretch: 1;
	overflow: elide;
    }

    ThemedButton {
	text: "Esci";
	clicked => { root.logout(); }
    }
}

component MeetingsPage {
    in property <float> ui-scale;
    in property <string> account-name;
    in property <[MeetingRow]> meetings;
    in property <bool> loading;
    in property <string> error;

    callback select(int);
    callback open-editor(int);
    callback refresh();
    callback logout();
    callback free-slots();

    init => { root.refresh(); }

    Timer {
	interval: 60s;
	running: true;

	triggered() => { root.refresh(); }
    }

    VerticalBox {
	padding: 25px * ui-scale;
	spacing: 10px * ui-scale;

	AccountBar {
	    account-name: root.account-name;
	    ui-scale: root.ui-scale;
	    logout => { root.logout(); }
	}

	AppText {
	    text: "I meeting di oggi";
	    font-size: 22px * root.ui-scale;
	    horizontal-alignment: start;
	}

	if root.loading : AppText {
	    text: "Caricamento…";
	    font-size: 14px * root.ui-scale;
	    vertical-stretch: 1;
	}

	if !root.loading && root.error != "" && root.meetings.length == 0 : AppText {
	    text: root.error;
	    color: AppTheme.accent;
	    font-size: 14px * root.ui-scale;
	    wrap: word-wrap;
	    vertical-stretch: 1;
	}

	if !root.loading && root.error == "" && root.meetings.length == 0 : AppText {
	    text: "Nessun altro meeting oggi.";
	    font-size: 14px * root.ui-scale;
	    vertical-stretch: 1;
	}

	if !root.loading && root.error != "" && root.meetings.length > 0 : AppText {
	    text: root.error;
	    color: AppTheme.accent;
	    font-size: 12px * root.ui-scale;
	    wrap: word-wrap;
	}

	if !root.loading && root.meetings.length > 0 : ListView {
	    vertical-stretch: 1;

	    for row[index] in root.meetings : Rectangle {
		height: 54px * root.ui-scale;

		Rectangle {
		    height: parent.height - 6px * root.ui-scale;
		    border-radius: 4px;
		    border-width: row.in-progress ? 2px : 0px;
		    border-color: AppTheme.accent;
		    background: row.in-progress
			? (touch.has-hover ? AppTheme.accent.transparentize(0.65) : AppTheme.accent.transparentize(0.8))
			: (touch.has-hover ? #80808040 : #80808022);

		    touch := TouchArea {
			clicked => { root.select(index); }
		    }

		    HorizontalLayout {
			padding-left: 12px * root.ui-scale;
			padding-right: 12px * root.ui-scale;
			spacing: 12px * root.ui-scale;

			AppText {
			    text: row.time-range;
			    font-size: 16px * root.ui-scale;
			    vertical-alignment: center;
			}

			AppText {
			    text: row.title;
			    font-size: 16px * root.ui-scale;
			    vertical-alignment: center;
			    horizontal-stretch: 1;
			    overflow: elide;
			}

			HorizontalLayout {
			    spacing: 4px * root.ui-scale;

			    AppText {
				text: row.attendees;
				font-size: 12px * root.ui-scale;
				vertical-alignment: center;
			    }

			    if row.has-template : AppText {
				text: "· slot salvati";
				color: AppTheme.accent;
				font-size: 12px * root.ui-scale;
				vertical-alignment: center;
			    }
			}

			VerticalLayout {
			    alignment: center;

			    AccentButton {
				text: "Editor";
				font-size: 11px * root.ui-scale;
				clicked => { root.open-editor(index); }
			    }
			}
		    }
		}
	    }
	}

	HorizontalLayout {
	    alignment: start;

	    ThemedButton {
		text: "Orari liberi";
		clicked => { root.free-slots(); }
	    }
	}
    }
}

component EditorPage {
    in property <float> ui-scale;
    in property <string> title;
    in property <string> time-range;
    in property <string> duration;
    in property <bool> attendees-warning;
    in property <bool> loading;
    in property <bool> busy;
    in property <string> notice;
    in property <string> unassigned;
    in property <bool> over;
    in property <bool> has-template;
    in property <[EditorRow]> rows;

    callback set-label(int, string);
    callback set-minutes(int, int);
    callback set-included(int, bool);
    callback move-up(int);
    callback move-down(int);
    callback remove-row(int);
    callback add-row();
    callback reset();
    callback save();
    callback delete-template();
    callback start-meeting();
    callback back();

    VerticalBox {
        padding: 15px * root.ui-scale;
        spacing: 6px * root.ui-scale;

        AppText {
            text: root.title;
            font-size: 20px * root.ui-scale;
            overflow: elide;
        }

        AppText {
            text: root.time-range + "  ·  " + root.duration;
            font-size: 12px * root.ui-scale;
        }

        if root.attendees-warning : AppText {
            text: "Lista partecipanti incompleta: aggiungi le voci mancanti";
            color: AppTheme.accent;
            font-size: 12px * root.ui-scale;
            wrap: word-wrap;
        }

        if root.loading : AppText {
            text: "Caricamento…";
            font-size: 14px * root.ui-scale;
            vertical-stretch: 1;
        }

        if !root.loading : ListView {
            vertical-stretch: 1;

            for row[index] in root.rows : Rectangle {
                height: 44px * root.ui-scale;
                opacity: row.included ? 1 : 0.5;

                HorizontalLayout {
                    padding-right: 8px * root.ui-scale;
                    padding-top: 2px * root.ui-scale;
                    padding-bottom: 2px * root.ui-scale;
                    spacing: 6px * root.ui-scale;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;

                        LineEdit {
                            text <=> row.label;
                            font-size: 12px * root.ui-scale;
                            edited(text) => { root.set-label(index, text); }
                        }

                        if row.attendee : AppText {
                            text: row.email;
                            font-size: 9px * root.ui-scale;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        SpinBox {
                            width: 70px * root.ui-scale;
                            minimum: 0;
                            maximum: 600;
                            value <=> row.minutes;
                            edited(value) => { root.set-minutes(index, value); }
                        }
                    }

                    AppText {
                        text: "min";
                        font-size: 12px * root.ui-scale;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;

                        ThemedButton {
                            text: "su";
                            enabled: index > 0;
                            clicked => { root.move-up(index); }
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        ThemedButton {
                            text: "giù";
                            enabled: index < root.rows.length - 1;
                            clicked => { root.move-down(index); }
                        }
                    }

                    if row.attendee : VerticalLayout {
                        alignment: center;

                        CheckBox {
                            text: "incluso";
                            checked <=> row.included;
                            toggled => { root.set-included(index, self.checked); }
                        }
                    }

                    if !row.attendee : VerticalLayout {
                        alignment: center;

                        ThemedButton {
                            text: "Rimuovi";
                            clicked => { root.remove-row(index); }
                        }
                    }
                }
            }
        }

        if root.notice != "" : AppText {
            text: root.notice;
            color: AppTheme.accent;
            font-size: 12px * root.ui-scale;
        }

        AppText {
            text: root.unassigned;
            color: root.over ? AppTheme.accent : AppTheme.text;
            font-size: 14px * root.ui-scale;
        }

        HorizontalLayout {
            spacing: 6px * root.ui-scale;
            alignment: start;

            ThemedButton {
                text: "Aggiungi voce";
                enabled: !root.loading;
                clicked => { root.add-row(); }
            }

            ThemedButton {
                text: "Ripristina slot uguali";
                enabled: !root.loading;
                clicked => { root.reset(); }
            }

            ThemedButton {
                text: "Salva come preferenza";
                enabled: !root.loading && !root.busy;
                clicked => { root.save(); }
            }

            if root.has-template : ThemedButton {
                text: "Elimina preferenza";
                enabled: !root.loading && !root.busy;
                clicked => { root.delete-template(); }
            }
        }

        HorizontalLayout {
            spacing: 10px * root.ui-scale;
            alignment: start;

            AccentButton {
                text: "Avvia";
                font-size: 14px * root.ui-scale;
                clicked => { if (!root.loading) { root.start-meeting(); } }
            }

            ThemedButton {
                text: "Indietro";
                clicked => { root.back(); }
            }
        }
    }
}

component TimerPage {
    in property<float> ui-scale;
    in property <duration> timer-time;
    in property <bool> running-state;
    in property <bool> has-slots;
    in property <string> slot-name;
    in property <duration> slot-time;
    in property <string> next-slot-name;
    in property <bool> slots-warning;
    in property <bool> plan-loading;
    in property <bool> plan-warning;

    callback stop(StopType);
    callback tick();
    callback next-slot();

    timer := Timer {
	interval  : 0.25s;
	running: running-state;

	triggered() => {
	    if (running-state) {
		tick();
	    } 
	}
    }

    property <int> total-seconds: Math.ceil(timer-time / 1s);
    property <int> hours  : Math.floor(total-seconds / 3600);
    property <int> minutes: Math.mod(Math.floor(total-seconds / 60), 60);
    property <int> seconds: Math.mod(total-seconds, 60);
    property <string> displayTimer: 
        (hours >= 1 ? "0" + hours + ":" : "") +
        (minutes < 10 ? "0" : "") + minutes + ":" +
        (seconds < 10 ? "0" : "") + seconds;

    property <int> slot-total-seconds: Math.ceil(slot-time / 1s);
    property <int> slot-hours  : Math.floor(slot-total-seconds / 3600);
    property <int> slot-minutes: Math.mod(Math.floor(slot-total-seconds / 60), 60);
    property <int> slot-seconds: Math.mod(slot-total-seconds, 60);
    property <string> slot-display:
        (slot-hours >= 1 ? "0" + slot-hours + ":" : "") +
        (slot-minutes < 10 ? "0" : "") + slot-minutes + ":" +
        (slot-seconds < 10 ? "0" : "") + slot-seconds;

    VerticalBox {
	alignment: center;
	padding: 25px * ui-scale;


	AppText {
	    text: displayTimer;
	    color: AppTheme.accent;
	    font-size: 100px * root.ui-scale;
	    horizontal-alignment: center;
	}

	if root.has-slots : AppText {
	    text: root.slot-name + "  " + root.slot-display;
	    font-size: 32px * root.ui-scale;
	    horizontal-alignment: center;
	    overflow: elide;
	}

	if root.has-slots && root.next-slot-name != "" : AppText {
	    text: "Poi: " + root.next-slot-name;
	    font-size: 18px * root.ui-scale;
	    horizontal-alignment: center;
	    overflow: elide;
	}

	if root.plan-loading : AppText {
	    text: "Caricamento slot…";
	    font-size: 14px * root.ui-scale;
	    horizontal-alignment: center;
	}

	if root.plan-warning : AppText {
	    text: "Preferenza non caricata: slot uguali";
	    color: AppTheme.accent;
	    font-size: 12px * root.ui-scale;
	    horizontal-alignment: center;
	}

	if root.slots-warning : AppText {
	    text: "Lista partecipanti incompleta";
	    color: AppTheme.accent;
	    font-size: 12px * root.ui-scale;
	    horizontal-alignment: center;
	}

	HorizontalBox {
	    alignment: center;

	    if root.has-slots : ThemedButton {
		text: "Avanti";
		clicked => { next-slot(); }
	    }

	    ThemedButton {
		text: "Stop";
		clicked => { stop(StopType.UserStopped); }
	    }
	}
    }
}

export component MainWindow inherits Window {
    title: "Schisaciaccole";
    background: AppTheme.panel;
    icon: @image-url("../assets/icon_256.png");
    preferred-width: 800px;
    preferred-height: 600px;
    default-font-family: "Plus Jakarta Sans";
    forward-focus: scope;

    property <bool> on-top: false;
    // Single-letter shortcuts are off on the editor page, where names are typed.
    property <bool> letter-keys-enabled: page != Page.EditorPage;

    always-on-top: on-top;

    property <float> ui-scale: Math.min(root.width / 526px, root.height / 326px);

    in property     <duration> timer-time: 3s;
    in property     <bool>     running-state: false;
    in property     <Page>     page: SelectionPage; 
    in property     <[TimeOption]> options;
    in property     <bool>     is-macos;
    in property     <bool>     signed-in;
    in property     <string>   account-name;
    in property     <string>   notice;
    in property     <string>   login-status;
    in property     <bool>     login-waiting;
    in property     <[MeetingRow]> meetings;
    in property     <bool>     meetings-loading;
    in property     <string>   meetings-error;
    in property     <bool>     has-slots;
    in property     <string>   slot-name;
    in property     <duration> slot-time;
    in property     <string>   next-slot-name;
    in property     <bool>     slots-warning;
    in property     <bool>     plan-loading;
    in property     <bool>     plan-warning;
    in property     <[EditorRow]> editor-rows;
    in property     <string>   editor-title;
    in property     <string>   editor-time-range;
    in property     <string>   editor-duration;
    in property     <bool>     editor-attendees-warning;
    in property     <bool>     editor-loading;
    in property     <bool>     editor-busy;
    in property     <string>   editor-notice;
    in property     <string>   editor-unassigned;
    in property     <bool>     editor-over;
    in property     <bool>     editor-has-template;

    callback select-time(int);
    callback compute-options();
    callback tick();
    callback set-selection-page();
    callback quit();
    callback fullscreen(bool);
    callback help();
    callback stop(StopType);
    callback login();
    callback cancel-login();
    callback skip-login();
    callback select-meeting(int);
    callback refresh-meetings();
    callback set-meetings-page();
    callback close-finished();
    callback logout();
    callback next-slot();
    callback open-editor(int);
    callback editor-set-label(int, string);
    callback editor-set-minutes(int, int);
    callback editor-set-included(int, bool);
    callback editor-move-up(int);
    callback editor-move-down(int);
    callback editor-remove-row(int);
    callback editor-add-row();
    callback editor-reset();
    callback editor-save();
    callback editor-delete();
    callback editor-start();
    callback editor-back();

    // Leaving the editor drops its focused text field: give the focus back to the shortcuts.
    changed page => {
        if (page != Page.EditorPage) {
            scope.focus();
        }
    }

    if is-macos: MenuBar {
	Menu {
	    title: @tr("Window");
	    MenuItem {
		title: @tr("Always on top");
		activated => { on-top = !on-top; }
		shortcut: @keys(Control + T);
	    }
	}
	Menu {
	    title: "Account";
	    if signed-in: MenuItem {
		title: "Esci dall'account";
		activated => { logout(); }
	    }
	}
    }

    scope := FocusScope {
        KeyBinding {
            keys: @keys(Q);
            enabled: root.letter-keys-enabled;
            activated => { quit(); }
        }

        KeyBinding {
            keys: @keys(M);
            enabled: root.letter-keys-enabled;
            activated => { fullscreen(false); }
        }

        KeyBinding {
            keys: @keys(Escape);
            activated => { fullscreen(true); }
        }

        KeyBinding {
            keys: @keys(T);
            enabled: root.letter-keys-enabled;
            activated => { on-top = !on-top; }
        }

        KeyBinding {
            keys: @keys(H);
            enabled: root.letter-keys-enabled;
            activated => { help(); }
        }

        KeyBinding {
            keys: @keys(N);
            enabled: root.letter-keys-enabled;
            activated => { next-slot(); }
        }
    }


    compute-options-timer := Timer {
	interval  : 3s;
	running: !running-state;
	
	triggered() => {
	    // when the main timer is stopped keep updating the selection
	    compute-options();
	}
    }


    // property <string> displayHour: 
    //     hours >= 1 ? "0" + hours : "";
    // property <string> displayMinute: 
    //     (minutes < 10 ? "0" : "") + minutes;
    // property <string> displaySeconds: 
    //     (seconds < 10 ? "0" : "") + seconds;

    if on-top : Rectangle {
        width: 10px;
        height: 10px;
        x: root.width - self.width - 2px; // Aligns to the right
        y: 2px; // Aligns to the top
        background: AppTheme.accent;
        border-radius: self.width / 2; // Makes the rectangle a circle
    }



    // render this if page is SelectionPage
    if page == Page.SelectionPage : VerticalBox {
	alignment: center;
	padding: 25px * ui-scale;


	if root.signed-in : AccountBar {
	    account-name: root.account-name;
	    ui-scale: root.ui-scale;
	    logout => { logout(); }
	}

	if root.signed-in : HorizontalLayout {
	    alignment: start;

	    ThemedButton {
		text: "I miei meeting";
		clicked => { set-meetings-page(); }
	    }
	}

	if root.notice != "" : AppText {
	    text: root.notice;
	    color: AppTheme.accent;
	    font-size: 12px * root.ui-scale;
	}

	AppText {
	    text: "Quando deve finire questa cerimonia?";
	    font-size: 22px * root.ui-scale;
	    horizontal-alignment: start;
	}

	GridLayout {
	    spacing: 15px * ui-scale;

	    for option[index] in root.options: SelectionButton {
		row: Math.floor(index / 4);
		col: Math.mod(index, 4);

		font-size: 18px * root.ui-scale;
		time: option.time;
		minutes: option.minutes;
		clicked => { select-time(index); }
	    }
	}
    }

    if page == Page.MeetingsPage : MeetingsPage {
	width: root.width;
	height: root.height;
	ui-scale: root.ui-scale;
	account-name: root.account-name;
	meetings: root.meetings;
	loading: root.meetings-loading;
	error: root.meetings-error;
	select(index) => { select-meeting(index); }
	open-editor(index) => { root.open-editor(index); }
	refresh => { refresh-meetings(); }
	logout => { logout(); }
	free-slots => { set-selection-page(); }
    }

    if page == Page.EditorPage : EditorPage {
	width: root.width;
	height: root.height;
	ui-scale: root.ui-scale;
	title: root.editor-title;
	time-range: root.editor-time-range;
	duration: root.editor-duration;
	attendees-warning: root.editor-attendees-warning;
	loading: root.editor-loading;
	busy: root.editor-busy;
	notice: root.editor-notice;
	unassigned: root.editor-unassigned;
	over: root.editor-over;
	has-template: root.editor-has-template;
	rows: root.editor-rows;
	set-label(index, text) => { root.editor-set-label(index, text); }
	set-minutes(index, value) => { root.editor-set-minutes(index, value); }
	set-included(index, included) => { root.editor-set-included(index, included); }
	move-up(index) => { root.editor-move-up(index); }
	move-down(index) => { root.editor-move-down(index); }
	remove-row(index) => { root.editor-remove-row(index); }
	add-row => { root.editor-add-row(); }
	reset => { root.editor-reset(); }
	save => { root.editor-save(); }
	delete-template => { root.editor-delete(); }
	start-meeting => { root.editor-start(); }
	back => { root.editor-back(); }
    }

    if page == Page.LoadingPage : VerticalBox {
	alignment: center;
	padding: 25px * ui-scale;

	AppText {
	    text: "Connessione…";
	    font-size: 22px * root.ui-scale;
	    horizontal-alignment: center;
	}
    }

    if page == Page.LoginPage : VerticalBox {
	alignment: center;
	padding: 25px * ui-scale;
	spacing: 15px * ui-scale;

	AppText {
	    text: "Accedi con Google";
	    color: AppTheme.accent;
	    font-size: 36px * root.ui-scale;
	    horizontal-alignment: center;
	}

	AppText {
	    text: "Vedrai i tuoi meeting di oggi e potrai avviare il countdown sulla fine del meeting.";
	    font-size: 14px * root.ui-scale;
	    horizontal-alignment: center;
	    wrap: word-wrap;
	}

	HorizontalLayout {
	    alignment: center;
	    spacing: 15px * ui-scale;

	    if !root.login-waiting : AccentButton {
		text: "Accedi con Google";
		font-size: 18px * root.ui-scale;
		clicked => { login(); }
	    }

	    if !root.login-waiting : ThemedButton {
		text: "Usa senza accesso";
		clicked => { skip-login(); }
	    }

	    if root.login-waiting : ThemedButton {
		text: "Annulla";
		clicked => { cancel-login(); }
	    }
	}

	AppText {
	    text: root.login-status;
	    font-size: 14px * root.ui-scale;
	    horizontal-alignment: center;
	    wrap: word-wrap;
	}
    }

    // render this if page is TimerPage
    if page == Page.TimerPage : TimerPage {
	ui-scale: root.ui-scale;
	timer-time: root.timer-time;
	running-state: root.running-state;
	has-slots: root.has-slots;
	slot-name: root.slot-name;
	slot-time: root.slot-time;
	next-slot-name: root.next-slot-name;
	slots-warning: root.slots-warning;
	plan-loading: root.plan-loading;
	plan-warning: root.plan-warning;
	next-slot => { root.next-slot(); }
	stop(stop-type) => { root.stop(stop-type); }
	tick => { root.tick(); }
    }

    
    if page == Page.TimerFinished : VerticalBox {
	alignment: center;
	padding: 25px * ui-scale;


	AppText {
	    text: "Congrats!\nScrum ceremony finished";
	    color: AppTheme.accent;
	    font-size: 36px * root.ui-scale;
	    horizontal-alignment: center;
	}

	AppText {
	    text: "Now get the fuck outta here";
	    color: AppTheme.text;
	    font-size: 24px * root.ui-scale;
	    horizontal-alignment: center;
	}


	HorizontalBox {
	    alignment: center;

	    ThemedButton {
		text: "Selection page";
		clicked => { close-finished(); }
	    }
	}
    }
    
}



export component Help inherits Window {
    title: "Schisaciaccole";
    background: AppTheme.panel;
    preferred-width: 526px;
    preferred-height: 320px;
    always-on-top: true;

    // Wrap in a conditional so the window does not statically adopt this
    // layout's font-driven size as its own (which loops: size -> ui-scale ->
    // font-size -> size). Same pattern as MainWindow's `if page == ...` bodies.
    VerticalBox {
	width: root.width;
	height: root.height;
	alignment: center;

	AppText {
	    text: "Keybindings:";
	    color: AppTheme.text;
	    font-size: 24px;
	    horizontal-alignment: center;
	}

	HorizontalLayout {
	    alignment: center;
	    GridLayout {
		spacing-horizontal: 50px;
		Row {
		    AppText {
			// text: "You can't start a timer with 0 seconds";
			text: "Q";
			font-size: 15pt;
			horizontal-alignment: left;
		    }

		    AppText {
			// text: "You can't start a timer with 0 seconds";
			text: "Quit";
			font-size: 15pt;
			horizontal-alignment: left;
		    }
		}
		Row {
		    AppText {
			// text: "You can't start a timer with 0 seconds";
			text: "M";
			font-size: 15pt;
			horizontal-alignment: left;
		    }

		    AppText {
			// text: "You can't start a timer with 0 seconds";
			text: "Toggle fullscreen";
			font-size: 15pt;
			horizontal-alignment: left;
		    }
		}
		Row {
		    AppText {
			// text: "You can't start a timer with 0 seconds";
			text: "Esc";
			font-size: 15pt;
			horizontal-alignment: left;
		    }

		    AppText {
			// text: "You can't start a timer with 0 seconds";
			text: "Exit fullscreen";
			font-size: 15pt;
			horizontal-alignment: left;
		    }
		}
		Row {
		    AppText {
			// text: "You can't start a timer with 0 seconds";
			text: "T";
			font-size: 15pt;
			horizontal-alignment: left;
		    }

		    AppText {
			// text: "You can't start a timer with 0 seconds";
			text: "Toggle always-on-top, showed by small circle in top right corner";
			font-size: 15pt;
			horizontal-alignment: left;
		    }
		}
		Row {
		    AppText {
			text: "N";
			font-size: 15pt;
			horizontal-alignment: left;
		    }

		    AppText {
			text: "Next speaker slot";
			font-size: 15pt;
			horizontal-alignment: left;
		    }
		}
	    }
	}

	AboutSlint {
	    height: 70px;
	}
    }
}
