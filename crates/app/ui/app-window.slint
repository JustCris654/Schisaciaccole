import { ListView, AboutSlint } from "std-widgets.slint";
import { AppTheme, AppText, PageTitle, PageSub, PillButton, PillKind, PlayIcon, StopIcon, HomeIcon, HelpIcon, DotsIcon, LogoutIcon, LogoMark, FadeFill, FocusRing, AppMotion, MotionProgress } from "theme.slint";

import "../assets/fonts/Manrope/static/Manrope-Regular.ttf";
import "../assets/fonts/Manrope/static/Manrope-Medium.ttf";
import "../assets/fonts/Manrope/static/Manrope-SemiBold.ttf";
import "../assets/fonts/Manrope/static/Manrope-Bold.ttf";
import "../assets/fonts/Manrope/static/Manrope-ExtraBold.ttf";

export enum Page { ManualPage, TimerPage, TimerFinished, LoadingPage, LoginPage, MeetingsPage }
export enum StopType { TimerFinished, UserStopped }

export struct TimeOption { time: string, minutes: string }
export struct MeetingRow {
    time-range: string,
    title: string,
    meta: string,
    in-progress: bool,
}

component BrandMark inherits LogoMark {
    bubble: AppTheme.dark ? AppTheme.text-brand : AppTheme.brand;
    hands: AppTheme.dark ? AppTheme.page : #FFFFFF;
}

component NavTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();
    forward-focus: focus;
    preferred-width: content.preferred-width;
    preferred-height: content.preferred-height;
    min-width: content.min-width;
    min-height: content.min-height;
    horizontal-stretch: 0;
    opacity: root.enabled ? 1 : 0.4;

    accessible-role: tab;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    FadeFill {
        width: parent.width;
        height: parent.height;
        border-radius: self.height / 2;
        target: root.selected
            ? (touch.has-hover ? AppTheme.nav-selected-hover : AppTheme.nav-selected)
            : (touch.has-hover ? AppTheme.nav-tab-hover : #FFFFFF00);
    }
    content := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        padding-bottom: 8px;
        Text {
            text: root.text;
            font-size: 17px;
            font-weight: 700;
            letter-spacing: 0.51px;
            vertical-alignment: center;
            color: root.selected ? AppTheme.brand : (touch.has-hover ? #FFFFFF : AppTheme.nav-tab-text);
            accessible-role: none;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (!root.enabled) { return reject; }
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if focus.has-focus : FocusRing { host-width: root.width; host-height: root.height; corner-radius: root.height / 2; }
}

component NavIconButton inherits Rectangle {
    in property <string> accessible-name;
    callback clicked();
    forward-focus: focus;
    width: 40px;
    height: 40px;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-action-default => { root.clicked(); }

    FadeFill {
        width: parent.width;
        height: parent.height;
        border-radius: self.height / 2;
        target: touch.has-hover ? AppTheme.nav-icon-hover : #FFFFFF00;
    }
    Rectangle {
        width: 26px;
        height: 26px;
        @children
    }
    touch := TouchArea { clicked => { root.clicked(); } }
    focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if focus.has-focus : FocusRing { host-width: root.width; host-height: root.height; corner-radius: 20px; }
}

component Navigation inherits Rectangle {
    in property <bool> meetings-page;
    in property <bool> signed-in;
    callback manual();
    callback meetings();
    callback logout();
    callback help();
    background: AppTheme.brand;
    height: 64px;

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 24px;

        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: start;
            spacing: 32px;
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    LogoMark { width: 38px; height: 38px; }
                }
                Text {
                    text: "Schisaciaccole";
                    color: #FFFFFF;
                    font-size: 22px;
                    font-weight: 800;
                    letter-spacing: -0.66px;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                NavTab {
                    text: "MANUALE";
                    selected: !root.meetings-page;
                    clicked => { root.manual(); }
                }
                NavTab {
                    text: "I MIEI MEETING";
                    selected: root.meetings-page;
                    enabled: root.signed-in;
                    clicked => { root.meetings(); }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            NavIconButton {
                accessible-name: "Aiuto";
                clicked => { root.help(); }
                HelpIcon { width: parent.width; height: parent.height; }
            }
            if root.signed-in : NavIconButton {
                accessible-name: "Altre azioni";
                clicked => { menu.show(); }
                DotsIcon { width: parent.width; height: parent.height; }
            }
        }
    }

    menu := PopupWindow {
        x: root.width - 32px - 200px;
        y: root.height - 6px;
        width: 200px;
        height: 65px;
        Rectangle {
            background: AppTheme.page;
            border-radius: AppTheme.radius-card;
            border-width: 1px;
            border-color: AppTheme.border-subtle;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #1E1A2629;
            VerticalLayout {
                padding: 8px;
                Rectangle {
                    border-radius: AppTheme.radius-item;
                    accessible-role: button;
                    accessible-label: "Logout";
                    accessible-action-default => { root.logout(); }
                    FadeFill {
                        width: parent.width;
                        height: parent.height;
                        border-radius: AppTheme.radius-item;
                        target: item-touch.has-hover ? AppTheme.surface : AppTheme.surface.transparentize(1);
                    }
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            LogoutIcon { width: 20px; height: 20px; }
                        }
                        Text {
                            text: "Logout";
                            color: AppTheme.text;
                            font-size: 15px;
                            font-weight: 500;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }
                    item-touch := TouchArea { clicked => { root.logout(); } }
                }
            }
        }
    }
}

component SlotCard inherits Rectangle {
    in property <string> time;
    in property <string> minutes;
    in property <bool> selected;
    callback clicked();
    forward-focus: focus;
    min-width: 100px;
    preferred-width: 100px;
    height: 112px;
    border-radius: AppTheme.radius-card;

    accessible-role: button;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-label: root.time + ", tra " + root.minutes + " min";
    accessible-action-default => { root.clicked(); }

    FadeFill {
        width: parent.width;
        height: parent.height;
        border-radius: AppTheme.radius-card;
        target: root.selected ? AppTheme.brand : AppTheme.surface;
    }
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: AppTheme.radius-card;
        border-width: 2px;
        border-color: touch.has-hover ? AppTheme.border-subtle : #FFFFFF00;
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        Text {
            text: root.time;
            font-size: 30px;
            font-weight: 800;
            letter-spacing: -0.6px;
            horizontal-alignment: center;
            color: root.selected ? AppTheme.on-brand : AppTheme.text;
            accessible-role: none;
        }
        Text {
            text: "tra " + root.minutes + " min";
            font-size: 15px;
            font-weight: 500;
            horizontal-alignment: center;
            color: root.selected ? #FFFFFFD9 : AppTheme.text-secondary;
            accessible-role: none;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
    focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if focus.has-focus : FocusRing { host-width: root.width; host-height: root.height; corner-radius: AppTheme.radius-card; }
}

component ManualPage inherits VerticalLayout {
    in property <string> current-time;
    in property <[TimeOption]> options;
    in property <int> selected-slot;
    in property <string> notice;
    callback select-slot(int);
    callback start-timer();
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 32px;
    padding-bottom: 40px;

    VerticalLayout {
        spacing: 12px;
        PageTitle { text: "Quando finisce il meeting?"; }
        HorizontalLayout {
            alignment: start;
            spacing: 5px;
            PageSub { text: "Sono le"; }
            HorizontalLayout {
                PageSub { text: root.current-time; color: AppTheme.text; font-weight: 700; }
                PageSub { text: ". Scegli l’orario di fine."; }
            }
        }
    }
    Rectangle { height: 32px; }
    GridLayout {
        height: 244px;
        spacing: 20px;
        for option[index] in root.options : SlotCard {
            row: floor(index / 4);
            col: mod(index, 4);
            horizontal-stretch: 1;
            time: option.time;
            minutes: option.minutes;
            selected: index == root.selected-slot;
            clicked => { root.select-slot(index); }
        }
    }
    if root.notice != "" : VerticalLayout {
        padding-top: 16px;
        AppText {
            text: root.notice;
            color: AppTheme.notice;
            font-size: 15px;
            wrap: word-wrap;
        }
    }
    Rectangle { vertical-stretch: 1; }
    HorizontalLayout {
        padding-top: 32px;
        alignment: end;
        PillButton {
            text: "Avvia timer";
            enabled: root.selected-slot >= 0;
            clicked => { root.start-timer(); }
            PlayIcon { width: 20px; height: 20px; tint: parent.foreground; }
        }
    }
}

component MeetingsPage inherits VerticalLayout {
    in property <string> account-name;
    in property <[MeetingRow]> meetings;
    in property <bool> loading;
    in property <string> error;
    callback select(int);
    callback refresh();
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 32px;
    padding-bottom: 40px;

    init => { root.refresh(); }
    Timer { interval: 60s; running: true; triggered => { root.refresh(); } }

    VerticalLayout {
        spacing: 12px;
        PageTitle { text: "I meeting di oggi"; }
        PageSub { text: "Google Calendar · " + root.account-name; overflow: elide; }
    }
    if root.loading : VerticalLayout {
        padding-top: 16px;
        AppText { text: "Caricamento…"; color: AppTheme.text-secondary; font-size: 15px; }
    }
    if root.error != "" : VerticalLayout {
        padding-top: 16px;
        AppText {
            text: root.error;
            color: AppTheme.notice;
            font-size: 15px;
            wrap: word-wrap;
        }
    }
    if !root.loading && root.error == "" && root.meetings.length == 0 : VerticalLayout {
        padding-top: 16px;
        AppText { text: "Nessun altro meeting oggi."; color: AppTheme.text-secondary; font-size: 15px; }
    }
    Rectangle { height: 32px; }
    ListView {
        vertical-stretch: 1;
        for row[index] in root.meetings : Rectangle {
            height: index == root.meetings.length - 1 ? 92px : 104px;
            Rectangle {
                y: 0px;
                height: 92px;
                border-radius: AppTheme.radius-card;
                background: AppTheme.surface;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 20px;
                    padding-bottom: 20px;
                    spacing: 24px;
                    Text {
                        width: 150px;
                        text: row.time-range;
                        font-size: 21px;
                        font-weight: 700;
                        color: AppTheme.text;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        alignment: center;
                        Text {
                            text: row.title;
                            font-size: 21px;
                            font-weight: 700;
                            color: AppTheme.text;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            if row.in-progress : VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: AppTheme.orange;
                                }
                            }
                            Text {
                                text: row.meta;
                                font-size: 15px;
                                color: AppTheme.text-secondary;
                                overflow: elide;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        PillButton {
                            text: "Avvia";
                            clicked => { root.select(index); }
                            PlayIcon { width: 20px; height: 20px; tint: parent.foreground; }
                        }
                    }
                }
            }
        }
    }
}

// One fixed-width cell of the countdown, so the digits never shift while they tick.
component ClockCell inherits Rectangle {
    in property <string> glyph;
    in property <bool> colon;
    in property <length> size;
    in property <color> tint;
    width: root.colon ? root.size * 0.28 : root.size * 0.6;
    height: root.size;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.glyph;
        font-size: root.size;
        font-weight: 800;
        color: root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// Countdown as MM:SS, or HH:MM:SS from one hour on. `size` shrinks to fit `max-width`.
component ClockText inherits Rectangle {
    in property <int> seconds;
    in property <length> size;
    in property <length> avail;
    in property <color> tint;
    private property <int> hours: floor(root.seconds / 3600);
    private property <int> minutes: mod(floor(root.seconds / 60), 60);
    private property <int> secs: mod(root.seconds, 60);
    private property <length> fitted: min(root.size, root.avail / (root.hours > 0 ? 4.3 : 2.8));
    height: root.fitted;
    horizontal-stretch: 1;

    accessible-role: text;
    accessible-label: root.hours > 0
        ? root.hours + ":" + (root.minutes < 10 ? "0" : "") + root.minutes + ":" + (root.secs < 10 ? "0" : "") + root.secs
        : (root.minutes < 10 ? "0" : "") + root.minutes + ":" + (root.secs < 10 ? "0" : "") + root.secs;

    HorizontalLayout {
        alignment: center;
        spacing: 0px;
        if root.hours > 0 : ClockCell { glyph: floor(root.hours / 10); size: root.fitted; tint: root.tint; }
        if root.hours > 0 : ClockCell { glyph: mod(root.hours, 10); size: root.fitted; tint: root.tint; }
        if root.hours > 0 : ClockCell { glyph: ":"; colon: true; size: root.fitted; tint: root.tint; }
        ClockCell { glyph: floor(root.minutes / 10); size: root.fitted; tint: root.tint; }
        ClockCell { glyph: mod(root.minutes, 10); size: root.fitted; tint: root.tint; }
        ClockCell { glyph: ":"; colon: true; size: root.fitted; tint: root.tint; }
        ClockCell { glyph: floor(root.secs / 10); size: root.fitted; tint: root.tint; }
        ClockCell { glyph: mod(root.secs, 10); size: root.fitted; tint: root.tint; }
    }
}

// Countdown screen. Children go between the end line and the Stop button.
component TimerPage inherits Rectangle {
    in property <duration> timer-time;
    in property <bool> running-state;
    in property <string> timer-end;
    callback stop(StopType);
    callback tick();
    // Compact rules below about 560px of width, large rules above.
    private property <bool> compact: root.width < 560px;
    private property <length> side: root.compact ? 16px : 32px;

    Timer {
        interval: 0.25s;
        running: root.running-state;
        triggered => { if (root.running-state) { root.tick(); } }
    }

    VerticalLayout {
        padding-left: root.side;
        padding-right: root.side;
        padding-top: root.compact ? 12px : 32px;
        padding-bottom: root.compact ? 12px : 40px;
        alignment: center;
        ClockText {
            seconds: max(0, ceil(root.timer-time / 1s));
            size: root.compact ? 84px : clamp(72px, root.width * 0.16, 160px);
            avail: root.width - 2 * root.side;
            tint: root.timer-time < 300s ? AppTheme.orange : AppTheme.text-brand;
        }
        Rectangle { height: root.compact ? 4px : 12px; }
        Text {
            text: "Fine alle " + root.timer-end;
            font-size: root.compact ? 13px : 19px;
            color: AppTheme.text-secondary;
            horizontal-alignment: center;
        }
        @children
        Rectangle {
            min-height: root.compact ? 24px : 16px;
            max-height: root.compact ? 32px : 112px;
            vertical-stretch: 1;
        }
        HorizontalLayout {
            alignment: center;
            PillButton {
                text: "Stop";
                kind: PillKind.outline;
                compact: root.compact;
                clicked => { root.stop(StopType.UserStopped); }
                StopIcon {
                    width: root.compact ? 12px : 16px;
                    height: root.compact ? 12px : 16px;
                    tint: parent.foreground;
                }
            }
        }
    }
}

component ConfettiPiece inherits Rectangle {
    in property <int> index;
    in property <duration> elapsed;
    in property <duration> delay;
    in property <length> area-width;
    in property <length> area-height;
    in property <color> tint;
    pure function rnd(k: int) -> float {
        let v = sin((root.index * 12.9898 + k * 78.233) * 1rad) * 43758.5453;
        return v - floor(v);
    }
    // Frames at 60 per second since the piece was thrown.
    private property <float> n: max(0, (root.elapsed - root.delay) / 1ms * 0.06);
    private property <float> vx: (rnd(1) - 0.5) * 14;
    private property <float> vy: -rnd(2) * 13 - 4;
    private property <length> px: root.area-width / 2 + (rnd(3) - 0.5) * root.area-width * 0.3
        + root.vx * (1 - pow(0.985, root.n)) / 0.015 * 1px;
    private property <length> py: root.area-height * 0.45 + (root.vy * root.n + 0.175 * root.n * (root.n + 1)) * 1px;
    private property <float> fade: clamp(1 - (root.py - root.area-height * 0.9) / (root.area-height * 0.1 + 40px), 0, 1);
    x: root.px;
    y: root.py;
    width: (6 + rnd(4) * 6) * 1px;
    height: (8 + rnd(5) * 8) * 1px;
    background: root.tint;
    opacity: root.fade;
    visible: root.elapsed >= root.delay && root.fade > 0;
    transform-rotation: (rnd(6) * 3.14159 + (rnd(7) - 0.5) * 0.3 * root.n) * 57.2958deg;
}

// "Meeting terminato!" with rotating captions and confetti.
component FinishedPage inherits Rectangle {
    in property <int> seed;
    callback home();
    private property <bool> compact: root.width < 560px;
    private property <length> side: root.compact ? 16px : 32px;
    private property <[string]> captions: [
        "Finalmente.",
        "Poteva essere una mail. Ma ce l’abbiamo fatta.",
        "Nessun partecipante è stato maltrattato.",
        "GG. Si va a pranzo?",
        "Il countdown ha vinto, ancora una volta.",
        "Ultima slide? Non c’era nessuna slide.",
        "Mission accomplished (quella di finire in orario).",
        "Stand-up seduto, ma in orario.",
        "Le colonne hanno retto.",
    ];
    private property <int> current;
    private property <int> previous;
    private property <duration> started;
    private property <bool> settled;
    private property <duration> elapsed: root.settled ? 12s : animation-tick() - root.started;
    private property <float> pop: clamp(intro.value * 1100 / 700, 0, 1);
    private property <float> rise: clamp((intro.value * 1100 - 500) / 600, 0, 1);
    private property <float> swap-in: clamp((swap.value - 0.43) / 0.57, 0, 1);
    private property <float> swap-out: clamp(swap.value / 0.43, 0, 1);

    intro := MotionProgress { duration: 1100ms; }
    swap := MotionProgress { duration: 700ms; }

    init => {
        root.started = animation-tick();
        root.current = mod(root.seed, root.captions.length);
        root.previous = root.current;
        intro.restart();
    }
    Timer {
        interval: 2800ms;
        running: true;
        triggered => {
            root.previous = root.current;
            root.current = mod(root.current + 1, root.captions.length);
            swap.restart();
        }
    }
    Timer {
        interval: 12s;
        running: !root.settled;
        triggered => { root.settled = true; }
    }

    if !AppMotion.reduced : Rectangle {
        width: parent.width;
        height: parent.height;
        for i in 140 : ConfettiPiece {
            index: i;
            elapsed: root.elapsed;
            delay: 0ms;
            area-width: root.width;
            area-height: root.height;
            tint: i < 0 ? #000000 : (mod(i, 5) == 0 ? #6B2FBF : (mod(i, 5) == 1 ? #E07B00 : (mod(i, 5) == 2 ? #F6C453 : (mod(i, 5) == 3 ? #C9B3F0 : (AppTheme.dark ? #F3EFF9 : #1E1A26)))));
        }
        for i in 40 : ConfettiPiece {
            index: 200 + i;
            elapsed: root.elapsed;
            delay: 1800ms + i * 155ms;
            area-width: root.width;
            area-height: root.height;
            tint: mod(i, 5) == 0 ? #6B2FBF : (mod(i, 5) == 1 ? #E07B00 : (mod(i, 5) == 2 ? #F6C453 : (mod(i, 5) == 3 ? #C9B3F0 : (AppTheme.dark ? #F3EFF9 : #1E1A26))));
        }
    }

    VerticalLayout {
        padding-left: root.side;
        padding-right: root.side;
        padding-top: root.compact ? 12px : 32px;
        padding-bottom: root.compact ? 12px : 40px;
        alignment: center;
        spacing: root.compact ? 8px : 24px;
        Text {
            text: "Meeting terminato!";
            font-size: root.compact ? 30px : clamp(34px, root.width * 0.06, 56px);
            font-weight: 800;
            letter-spacing: -0.03 * self.font-size;
            color: AppTheme.text-brand;
            horizontal-alignment: center;
            wrap: word-wrap;
            opacity: root.pop < 0.6 ? root.pop / 0.6 : 1;
            transform-scale: root.pop < 0.6 ? 0.4 + 0.68 * (root.pop / 0.6) : 1.08 - 0.08 * ((root.pop - 0.6) / 0.4);
            transform-rotation: (root.pop < 0.6 ? -6 + 8 * (root.pop / 0.6) : 2 - 2 * ((root.pop - 0.6) / 0.4)) * 1deg;
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: min(340px, root.width - 2 * root.side);
                height: root.compact ? 34px : 54px;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.captions[swap.active && swap.value < 0.43 ? root.previous : root.current];
                    font-size: root.compact ? 12px : 18px;
                    font-weight: 600;
                    color: AppTheme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    opacity: swap.active ? (swap.value < 0.43 ? 1 - root.swap-out : root.swap-in) : 1;
                    y: swap.active ? (swap.value < 0.43 ? -8px * root.swap-out : 8px * (1 - root.swap-in)) : 0px;
                }
            }
        }
        Rectangle { height: 16px; }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: home-button.preferred-width;
                height: home-button.preferred-height;
                home-button := PillButton {
                    width: parent.width;
                    height: parent.height;
                    y: (1 - root.rise) * 12px;
                    opacity: root.rise;
                    text: "Torna alla home";
                    kind: PillKind.outline;
                    compact: root.compact;
                    clicked => { root.home(); }
                    HomeIcon {
                        width: root.compact ? 12px : 16px;
                        height: root.compact ? 12px : 16px;
                        tint: parent.foreground;
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Schisaciaccole";
    background: AppTheme.page;
    icon: @image-url("../assets/icon_256.png");
    preferred-width: 880px;
    min-width: root.timer-mode ? 360px : 800px;
    preferred-height: 660px;
    min-height: root.timer-mode ? 240px : 600px;
    default-font-family: "Manrope";
    forward-focus: scope;

    in-out property <bool> on-top: false;
    always-on-top: on-top;
    // True while a countdown screen shows; allows the small window.
    in property <bool> timer-mode: false;

    in-out property <bool> reduce-motion <=> AppMotion.reduced;
    page-fade := MotionProgress { duration: 180ms; }

    in property <string> current-time;
    in property <string> timer-end;
    in property <int> finish-seed;

    in property     <duration> timer-time: 3s;
    in property     <bool>     running-state: false;
    in property     <Page>     page: Page.ManualPage;
    in property     <[TimeOption]> options;
    in property     <int>      selected-slot: -1;
    in property     <bool>     is-macos;
    in property     <bool>     signed-in;
    in property     <string>   account-name;
    in property     <string>   notice;
    in property     <string>   login-status;
    in property     <bool>     login-waiting;
    in property     <[MeetingRow]> meetings;
    in property     <bool>     meetings-loading;
    in property     <string>   meetings-error;

    callback select-slot(int);
    callback start-selected();
    callback compute-options();
    callback tick();
    callback set-manual-page();
    callback quit();
    callback fullscreen(bool);
    callback help();
    callback stop(StopType);
    callback login();
    callback cancel-login();
    callback skip-login();
    callback select-meeting(int);
    callback refresh-meetings();
    callback set-meetings-page();
    callback close-finished();
    callback logout();

    changed page => { page-fade.restart(); }

    if is-macos: MenuBar {
	Menu {
	    title: @tr("Window");
	    MenuItem {
		title: @tr("Always on top");
		activated => { on-top = !on-top; }
		shortcut: @keys(Control + T);
	    }
	}
	Menu {
	    title: "Account";
	    if signed-in: MenuItem {
		title: "Esci dall'account";
		activated => { logout(); }
	    }
	}
    }

    scope := FocusScope {
        KeyBinding {
            keys: @keys(Q);
            activated => { quit(); }
        }

        KeyBinding {
            keys: @keys(M);
            activated => { fullscreen(false); }
        }

        KeyBinding {
            keys: @keys(Escape);
            activated => { fullscreen(true); }
        }

        KeyBinding {
            keys: @keys(T);
            activated => { on-top = !on-top; }
        }

        KeyBinding {
            keys: @keys(H);
            activated => { help(); }
        }
    }


    compute-options-timer := Timer {
	interval  : 3s;
	running: !running-state;

	triggered() => {
	    // when the main timer is stopped keep updating the selection
	    compute-options();
	}
    }


    page-body := Rectangle {
        width: root.width;
        height: root.height;
        opacity: page-fade.value;
        if page == Page.ManualPage || page == Page.MeetingsPage : VerticalLayout {
            Navigation {
                meetings-page: root.page == Page.MeetingsPage;
                signed-in: root.signed-in;
                manual => { root.set-manual-page(); }
                meetings => {
                    if (root.page == Page.MeetingsPage) {
                        root.refresh-meetings();
                    } else {
                        root.set-meetings-page();
                    }
                }
                logout => { root.logout(); }
                help => { root.help(); }
            }
            if page == Page.ManualPage : ManualPage {
                current-time: root.current-time;
                options: root.options;
                selected-slot: root.selected-slot;
                notice: root.notice;
                select-slot(index) => { root.select-slot(index); }
                start-timer => { root.start-selected(); }
            }
            if page == Page.MeetingsPage : MeetingsPage {
                account-name: root.account-name;
                meetings: root.meetings;
                loading: root.meetings-loading;
                error: root.meetings-error;
                select(index) => { root.select-meeting(index); }
                refresh => { root.refresh-meetings(); }
            }
        }
        if page == Page.LoadingPage : VerticalLayout {
            padding: 32px;
            alignment: center;
            spacing: 16px;
            HorizontalLayout {
                alignment: center;
                BrandMark { width: 64px; height: 64px; }
            }
            PageTitle { text: "Connessione…"; horizontal-alignment: center; }
            PageSub { text: "Prepariamo i tuoi meeting."; horizontal-alignment: center; }
        }
        if page == Page.LoginPage : VerticalLayout {
            padding: 48px;
            spacing: 20px;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                BrandMark { width: 64px; height: 64px; }
            }
            PageTitle { text: "Accedi con Google"; horizontal-alignment: center; }
            PageSub {
                text: "I tuoi meeting di oggi, con un tempo per ogni voce.";
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            HorizontalLayout {
                padding-top: 8px;
                alignment: center;
                spacing: 16px;
                if !root.login-waiting : PillButton {
                    text: "Accedi con Google";
                    clicked => { root.login(); }
                }
                if !root.login-waiting : PillButton {
                    text: "Usa senza accesso";
                    kind: PillKind.ghost;
                    clicked => { root.skip-login(); }
                }
                if root.login-waiting : PillButton {
                    text: "Annulla";
                    kind: PillKind.ghost;
                    clicked => { root.cancel-login(); }
                }
            }
            AppText {
                text: root.login-status;
                color: AppTheme.notice;
                font-size: 15px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
        if page == Page.TimerPage : TimerPage {
            width: root.width;
            height: root.height;
            timer-time: root.timer-time;
            running-state: root.running-state;
            timer-end: root.timer-end;
            stop(stop-type) => { root.stop(stop-type); }
            tick => { root.tick(); }
        }
        if page == Page.TimerFinished : FinishedPage {
            width: root.width;
            height: root.height;
            seed: root.finish-seed;
            home => { root.close-finished(); }
        }
    }
    if on-top : Rectangle {
        width: 8px;
        height: 8px;
        x: root.width - 12px;
        y: 4px;
        background: AppTheme.orange;
        border-radius: 4px;
    }
}

component KeyChip inherits Rectangle {
    in property <string> key;
    width: 64px;
    height: 36px;
    border-radius: AppTheme.radius-item;
    background: AppTheme.surface;
    Text {
        text: root.key;
        color: AppTheme.text-brand;
        font-size: 16px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Help inherits Window {
    title: "Schisaciaccole · Scorciatoie";
    background: AppTheme.page;
    preferred-width: 640px;
    preferred-height: 440px;
    min-width: 600px;
    min-height: 420px;
    always-on-top: true;
    default-font-family: "Manrope";

    VerticalLayout {
        padding: 32px;
        spacing: 20px;
        PageTitle { text: "Scorciatoie da tastiera"; font-size: 28px; letter-spacing: -0.56px; }
        GridLayout {
            spacing-horizontal: 24px;
            spacing-vertical: 12px;
            Row { KeyChip { key: "Q"; } AppText { text: "Esci dall’app"; font-size: 16px; vertical-alignment: center; } }
            Row { KeyChip { key: "M"; } AppText { text: "Attiva o disattiva lo schermo intero"; font-size: 16px; vertical-alignment: center; } }
            Row { KeyChip { key: "Esc"; } AppText { text: "Esci dallo schermo intero"; font-size: 16px; vertical-alignment: center; } }
            Row { KeyChip { key: "T"; } AppText { text: "Mantieni la finestra in primo piano"; font-size: 16px; vertical-alignment: center; } }
            Row { KeyChip { key: "H"; } AppText { text: "Mostra le scorciatoie"; font-size: 16px; vertical-alignment: center; } }
        }
        AboutSlint { height: 50px; }
    }
}
