import { ThemedButton, CompactButton, ThemedField, ScrollList } from "editor-controls.slint";
import { ListView, AboutSlint } from "std-widgets.slint";
import { AppTheme, AppText, PageTitle, PageSub, PillButton, PillKind, PlayIcon, StopIcon, PauseIcon, SkipIcon, HomeIcon, PeopleIcon, EyeOffIcon, ChevronIcon, StepIcon, DotsIcon, LogoutIcon, LogoMark, FadeFill, FocusRing, AppMotion, MotionProgress } from "theme.slint";

import "../assets/fonts/MomoTrustDisplay/MomoTrustDisplay-Regular.ttf";
import "../assets/fonts/Manrope/static/Manrope-Bold.ttf";

export enum Page { ManualPage, TimerPage, TimerFinished, LoadingPage, LoginPage, MeetingsPage, EditorPage }
export enum StopType { TimerFinished, UserStopped }
export enum TurnView { Plain, Settings, Running, Daily }

export struct EditorRow {
    label: string,
    included: bool,
    attendee: bool,
    email: string,
}

export struct TimeOption { time: string, minutes: string }
export struct MeetingRow {
    time-range: string,
    title: string,
    meta: string,
    in-progress: bool,
    daily-on: bool,
    daily-auto: bool,
    attendees-warning: bool,
}

component BrandMark inherits LogoMark {
    bubble: AppTheme.dark ? AppTheme.text-brand : AppTheme.brand;
    hands: AppTheme.dark ? AppTheme.page : #FFFFFF;
}

component NavTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();
    forward-focus: focus;
    preferred-width: content.preferred-width;
    preferred-height: content.preferred-height;
    min-width: content.min-width;
    min-height: content.min-height;
    horizontal-stretch: 0;
    opacity: root.enabled ? 1 : 0.4;

    accessible-role: tab;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    content := HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        Text {
            text: root.text;
            font-size: 14px;
            font-weight: 400;
            vertical-alignment: center;
            color: root.selected || touch.has-hover ? AppTheme.text : AppTheme.text-secondary;
            accessible-role: none;
        }
    }
    Rectangle {
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        background: root.selected ? AppTheme.text-brand : AppTheme.page;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (!root.enabled) { return reject; }
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if focus.has-focus : FocusRing { host-width: root.width; host-height: root.height; corner-radius: root.height / 2; }
}

component NavIconButton inherits Rectangle {
    in property <string> accessible-name;
    callback clicked();
    forward-focus: focus;
    width: 40px;
    height: 40px;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-action-default => { root.clicked(); }

    FadeFill {
        width: parent.width;
        height: parent.height;
        border-radius: self.height / 2;
        target: touch.has-hover ? AppTheme.surface : AppTheme.surface.transparentize(1);
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 26px;
        height: 26px;
        @children
    }
    touch := TouchArea { clicked => { root.clicked(); } }
    focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if focus.has-focus : FocusRing { host-width: root.width; host-height: root.height; corner-radius: 20px; }
}

component Navigation inherits Rectangle {
    in property <bool> meetings-page;
    in property <bool> signed-in;
    callback manual();
    callback meetings();
    callback logout();
    private property <bool> narrow: root.width < 820px;
    private property <length> side: root.narrow ? 20px : 24px;
    background: AppTheme.page;
    height: root.narrow ? 110px : 76px;

    Text {
        x: (root.width - self.width) / 2;
        y: root.narrow ? 18px : (root.height - self.height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        text: "Schisaciaccole";
        color: AppTheme.text;
        font-size: 22px;
        font-weight: 400;
        letter-spacing: -0.66px;
        horizontal-alignment: center;
    }
    HorizontalLayout {
        x: root.side;
        y: root.narrow ? 59px : 18px;
        width: self.preferred-width;
        height: 40px;
        spacing: 20px;
        NavTab {
            text: "Manuale";
            selected: !root.meetings-page;
            clicked => { root.manual(); }
        }
        NavTab {
            text: "I miei meeting";
            selected: root.meetings-page;
            enabled: root.signed-in;
            clicked => { root.meetings(); }
        }
    }
    if root.signed-in : NavIconButton {
        x: root.width - root.side - self.width;
        y: root.narrow ? 59px : 18px;
        accessible-name: "Menu account";
        clicked => { menu.show(); }
        DotsIcon { width: parent.width; height: parent.height; tint: AppTheme.text; }
    }

    menu := PopupWindow {
        x: root.width - root.side - 200px;
        y: root.narrow ? 107px : 66px;
        width: 200px;
        height: 65px;
        Rectangle {
            background: AppTheme.page;
            border-radius: AppTheme.radius-card;
            border-width: 1px;
            border-color: AppTheme.border-subtle;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #1E1A2629;
            VerticalLayout {
                padding: 8px;
                Rectangle {
                    border-radius: AppTheme.radius-item;
                    accessible-role: button;
                    accessible-label: "Logout";
                    accessible-action-default => { root.logout(); }
                    FadeFill {
                        width: parent.width;
                        height: parent.height;
                        border-radius: AppTheme.radius-item;
                        target: item-touch.has-hover ? AppTheme.surface : AppTheme.surface.transparentize(1);
                    }
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            LogoutIcon { width: 20px; height: 20px; }
                        }
                        Text {
                            text: "Logout";
                            color: AppTheme.text;
                            font-size: 15px;
                            font-weight: 400;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }
                    item-touch := TouchArea { clicked => { root.logout(); } }
                }
            }
        }
    }
}

component SlotCard inherits Rectangle {
    in property <string> time;
    in property <string> minutes;
    in property <bool> selected;
    callback clicked();
    forward-focus: focus;
    min-width: 100px;
    preferred-width: 100px;
    height: 112px;
    border-radius: AppTheme.radius-card;

    accessible-role: button;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-label: root.time + ", tra " + root.minutes + " min";
    accessible-action-default => { root.clicked(); }

    FadeFill {
        width: parent.width;
        height: parent.height;
        border-radius: AppTheme.radius-card;
        target: root.selected ? AppTheme.brand : AppTheme.surface;
    }
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: AppTheme.radius-card;
        border-width: 1px;
        border-color: root.selected ? AppTheme.brand
            : (touch.has-hover ? AppTheme.text-brand : AppTheme.border-subtle);
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        Text {
            text: root.time;
            font-size: 30px;
            font-weight: 400;
            letter-spacing: -0.6px;
            horizontal-alignment: center;
            color: root.selected ? AppTheme.on-brand : AppTheme.text;
            accessible-role: none;
        }
        Text {
            text: "tra " + root.minutes + " min";
            font-size: 15px;
            font-weight: 400;
            horizontal-alignment: center;
            color: root.selected ? #F1E8FF : AppTheme.text-secondary;
            accessible-role: none;
        }
    }
    if root.selected : Path {
        x: parent.width - 26px;
        y: 9px;
        width: 15px;
        height: 15px;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: AppTheme.on-brand;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: "M3 8l3 3 7-7";
        accessible-role: none;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
    focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if focus.has-focus : FocusRing { host-width: root.width; host-height: root.height; corner-radius: AppTheme.radius-card; }
}

component ManualPage inherits VerticalLayout {
    in property <string> current-time;
    in property <[TimeOption]> options;
    in property <int> selected-slot;
    in property <string> notice;
    callback select-slot(int);
    callback start-timer();
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 32px;
    padding-bottom: 40px;

    VerticalLayout {
        spacing: 12px;
        PageTitle { text: "Quando finisce il meeting?"; color: AppTheme.timer-title; }
        HorizontalLayout {
            alignment: start;
            spacing: 5px;
            PageSub { text: "Sono le"; }
            HorizontalLayout {
                PageSub { text: root.current-time; color: AppTheme.text; font-weight: 400; }
                PageSub { text: ". Scegli l’orario di fine."; }
            }
        }
    }
    Rectangle { height: 32px; }
    GridLayout {
        height: 244px;
        spacing: 20px;
        for option[index] in root.options : SlotCard {
            row: floor(index / 4);
            col: mod(index, 4);
            horizontal-stretch: 1;
            time: option.time;
            minutes: option.minutes;
            selected: index == root.selected-slot;
            clicked => { root.select-slot(index); }
        }
    }
    if root.notice != "" : VerticalLayout {
        padding-top: 16px;
        AppText {
            text: root.notice;
            color: AppTheme.notice;
            font-size: 15px;
            wrap: word-wrap;
        }
    }
    Rectangle { vertical-stretch: 1; }
    HorizontalLayout {
        padding-top: 32px;
        alignment: end;
        PillButton {
            text: "Avvia timer";
            enabled: root.selected-slot >= 0;
            clicked => { root.start-timer(); }
            PlayIcon { width: 20px; height: 20px; tint: parent.foreground; }
        }
    }
}

struct DailyTooltipState {
    visible: bool,
    right: length,
    top: length,
    height: length,
    text: string,
}

// Daily switch of a meeting row, with the AUTO badge and a tooltip above it.
component DailySwitch inherits Rectangle {
    in property <bool> on;
    in property <bool> auto;
    callback toggled();
    callback tooltip-changed(DailyTooltipState);
    private property <DailyTooltipState> tooltip: {
        visible: touch.has-hover || focus.has-focus,
        right: root.absolute-position.x + root.width,
        top: root.absolute-position.y,
        height: root.auto ? 128px : 92px,
        text: root.tip,
    };
    changed tooltip => { root.tooltip-changed(root.tooltip); }
    private property <string> tip: "Modalità Daily: il timer parte subito e il tempo del meeting viene ripartito in parti uguali tra i partecipanti, chiamati a parlare in ordine casuale."
        + (root.auto ? " Riconosciuto in automatico dal titolo: puoi comunque cambiarlo." : "");
    forward-focus: focus;
    preferred-width: content.preferred-width;
    min-width: content.min-width;
    horizontal-stretch: 0;

    accessible-role: switch;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-label: "Daily";
    accessible-description: root.tip;
    accessible-action-default => { root.toggled(); }

    content := HorizontalLayout {
        spacing: 10px;
        alignment: center;
        if root.on && root.auto : VerticalLayout {
            alignment: center;
            Rectangle {
                height: 20px;
                width: auto-text.preferred-width + 16px;
                border-radius: 10px;
                background: AppTheme.page;
                border-width: 1px;
                border-color: AppTheme.border-subtle;
                auto-text := Text {
                    text: "AUTO";
                    font-size: 11px;
                    font-weight: 400;
                    letter-spacing: 0.66px;
                    color: AppTheme.text-brand;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            track := Rectangle {
                width: 44px;
                height: 26px;
                border-radius: 13px;
                background: root.on ? AppTheme.brand : AppTheme.border-subtle;
                animate background { duration: AppMotion.reduced ? 0ms : 150ms; }
                Rectangle {
                    y: 3px;
                    x: root.on ? 21px : 3px;
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    background: #FFFFFF;
                    drop-shadow-blur: 3px;
                    drop-shadow-offset-y: 1px;
                    drop-shadow-color: #1E1A2640;
                    animate x { duration: AppMotion.reduced ? 0ms : 150ms; }
                }
                if focus.has-focus : FocusRing { host-width: track.width; host-height: track.height; corner-radius: 13px; }
            }
        }
        Text {
            text: "Daily";
            font-size: 15px;
            font-weight: 400;
            color: AppTheme.text;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        clicked => { root.toggled(); }
    }
    focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.toggled();
                return accept;
            }
            return reject;
        }
    }
}

component DailyTooltip inherits Rectangle {
    in property <DailyTooltipState> tip;
    width: 280px;
    height: root.tip.height + 6px;
    Rectangle {
        height: root.tip.height;
        border-radius: AppTheme.radius-item;
        background: AppTheme.danger;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #1E1A2633;
        Text {
            x: 12px;
            y: 10px;
            width: parent.width - 24px;
            height: parent.height - 20px;
            text: root.tip.text;
            font-size: 13px;
            font-weight: 400;
            color: AppTheme.on-danger;
            wrap: word-wrap;
            vertical-alignment: top;
        }
    }
    Path {
        x: 280px - 18px - 12px;
        y: root.tip.height;
        width: 12px;
        height: 6px;
        viewbox-width: 12;
        viewbox-height: 6;
        fill: AppTheme.danger;
        commands: "M0 0H12L6 6z";
    }
}

component GroupsReconnect inherits VerticalLayout {
    in property <bool> waiting;
    in property <string> status;
    callback reconnect();
    callback cancel();
    spacing: 6px;
    AppText {
        text: "Autorizza Google Groups per leggere i membri. Calendar resta disponibile.";
        font-size: 12px;
        wrap: word-wrap;
        color: AppTheme.text-secondary;
    }
    HorizontalLayout {
        spacing: 8px;
        if !root.waiting : PillButton {
            text: "Ricollega Google";
            kind: PillKind.outline;
            clicked => { root.reconnect(); }
        }
        if root.waiting : PillButton {
            text: "Annulla accesso";
            kind: PillKind.outline;
            clicked => { root.cancel(); }
        }
        AppText {
            text: root.status;
            font-size: 12px;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}

component EditorPage inherits Rectangle {
    in property <string> title;
    in property <string> time-range;
    in property <string> duration;
    in property <bool> attendees-warning;
    in property <bool> groups-reconnect;
    in property <bool> login-waiting;
    in property <string> login-status;
    callback reconnect();
    callback cancel-login();
    in property <bool> busy;
    in property <string> notice;
    in property <bool> has-preference;
    in property <bool> daily-start;
    in property <[EditorRow]> rows;
    callback set-label(int, string);
    callback set-included(int, bool);
    callback remove-row(int);
    callback add-row();
    callback reset-participants();
    callback save();
    callback delete-preference();
    callback start-meeting();
    callback back();

    VerticalLayout {
        padding: 24px;
        spacing: 8px;
        PageTitle { text: "Partecipanti di questo meeting"; }
        AppText {
            text: root.title + " · " + root.time-range + " · " + root.duration;
            overflow: elide;
        }
        if root.attendees-warning : AppText {
            text: "Lista partecipanti incompleta: aggiungi i partecipanti mancanti";
            color: AppTheme.timer-title;
            font-size: 12px;
            wrap: word-wrap;
        }
        if root.groups-reconnect : GroupsReconnect {
            waiting: root.login-waiting;
            status: root.login-status;
            reconnect => { root.reconnect(); }
            cancel => { root.cancel-login(); }
        }
        ScrollList {
            vertical-stretch: 1;
            for row[index] in root.rows : Rectangle {
                height: 56px;
                Rectangle {
                    height: 52px;
                    border-radius: 8px;
                    background: AppTheme.surface;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 4px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            ThemedButton {
                                compact: true;
                                accessible-role: checkbox;
                                text: row.included ? "☑" : "☐";
                                accessible-name: "Includi " + row.label;
                                bare: true;
                                checkable: true;
                                checked: row.included;
                                clicked => { root.set-included(index, !row.included); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            ThemedField {
                                text <=> row.label;
                                placeholder-text: "Nome partecipante";
                                accessible-name: "Nome del partecipante " + (index + 1);
                                opacity: row.included ? 1 : 0.6;
                                edited(text) => { root.set-label(index, text); }
                            }
                            if row.attendee && row.email != "" : AppText {
                                text: row.email;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }
                        if !row.attendee : CompactButton {
                            text: "×";
                            accessible-name: "Rimuovi " + row.label;
                            bare: true;
                            clicked => { root.remove-row(index); }
                        }
                    }
                }
            }
            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                CompactButton {
                    text: "+ Aggiungi partecipante";
                    bare: true;
                    clicked => { root.add-row(); }
                }
            }
        }
        if root.notice != "" : AppText {
            text: root.notice;
            color: AppTheme.timer-title;
            font-size: 12px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            CompactButton {
                text: "←";
                accessible-name: "Indietro";
                bare: true;
                clicked => { root.back(); }
            }
            CompactButton {
                text: "Ripristina partecipanti";
                accessible-name: "Ripristina i partecipanti da calendario e preferenza";
                bare: true;
                clicked => { root.reset-participants(); }
            }
            if root.has-preference : CompactButton {
                text: "Elimina preferenza";
                bare: true;
                enabled: !root.busy;
                clicked => { root.delete-preference(); }
            }
            Rectangle { horizontal-stretch: 1; }
            ThemedButton {
                text: "Salva preferenza";
                width: 180px;
                enabled: !root.busy;
                clicked => { root.save(); }
            }
            ThemedButton {
                text: root.daily-start ? "Avvia Daily" : "Avvia";
                width: root.daily-start ? 128px : 96px;
                primary: true;
                clicked => { root.start-meeting(); }
            }
        }
    }
}


component MeetingsPage inherits Rectangle {
    in property <string> account-name;
    in property <[MeetingRow]> meetings;
    in property <bool> loading;
    in property <string> error;
    in property <bool> groups-reconnect;
    in property <bool> login-waiting;
    in property <string> login-status;
    callback reconnect();
    callback cancel-login();
    callback open-editor(int);
    callback select(int);
    callback set-daily(int, bool);
    callback refresh();
    private property <DailyTooltipState> tooltip;
    private property <int> tooltip-index: -1;
    private property <MeetingRow> tooltip-meeting;
    changed meetings => { root.tooltip.visible = false; root.tooltip-index = -1; }

    init => { root.refresh(); }
    Timer { interval: 60s; running: true; triggered => { root.refresh(); } }

    VerticalLayout {
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 32px;
        padding-bottom: 40px;

        VerticalLayout {
            spacing: 12px;
            PageTitle { text: "I meeting di oggi"; color: AppTheme.timer-title; }
            PageSub { text: "Google Calendar · " + root.account-name; overflow: elide; }
        }
        if root.loading : VerticalLayout {
            padding-top: 16px;
            AppText { text: "Caricamento…"; color: AppTheme.text-secondary; font-size: 15px; }
        }
        if root.error != "" : VerticalLayout {
            padding-top: 16px;
            AppText {
                text: root.error;
                color: AppTheme.notice;
                font-size: 15px;
                wrap: word-wrap;
            }
        }
        if root.groups-reconnect : GroupsReconnect {
            waiting: root.login-waiting;
            status: root.login-status;
            reconnect => { root.reconnect(); }
            cancel => { root.cancel-login(); }
        }
        if !root.loading && root.error == "" && root.meetings.length == 0 : VerticalLayout {
            padding-top: 16px;
            AppText { text: "Nessun altro meeting oggi."; color: AppTheme.text-secondary; font-size: 15px; }
        }
        Rectangle { height: 32px; }
        meeting-list := ListView {
            vertical-stretch: 1;
            for row[index] in root.meetings : Rectangle {
                height: (row.attendees-warning ? 116px : 92px) + (index == root.meetings.length - 1 ? 0px : 12px);
                Rectangle {
                    y: 0px;
                    height: row.attendees-warning ? 116px : 92px;
                    border-radius: AppTheme.radius-card;
                    background: AppTheme.surface;
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-top: 20px;
                        padding-bottom: 20px;
                        spacing: root.width < 900px ? 8px : 24px;
                        Text {
                            width: 150px;
                            text: row.time-range;
                            font-size: 21px;
                            font-weight: 400;
                            color: AppTheme.text;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            alignment: center;
                            Text {
                                text: row.title;
                                font-size: 21px;
                                font-weight: 400;
                                color: AppTheme.text;
                                overflow: elide;
                            }
                            if row.attendees-warning : Text {
                                text: "Lista partecipanti incompleta";
                                font-size: 12px;
                                color: AppTheme.timer-title;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                if row.in-progress : VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: AppTheme.orange;
                                    }
                                }
                                Text {
                                    text: row.meta;
                                    font-size: 15px;
                                    color: AppTheme.text-secondary;
                                    overflow: elide;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            DailySwitch {
                                on: row.daily-on;
                                auto: row.daily-auto;
                                toggled => { root.set-daily(index, !row.daily-on); }
                                tooltip-changed(tip) => {
                                    if (tip.visible) {
                                        root.tooltip-index = index;
                                        root.tooltip-meeting = row;
                                        root.tooltip = tip;
                                    } else if (root.tooltip-index == index) {
                                        root.tooltip = tip;
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 8px;
                                PillButton {
                                    text: "Editor";
                                    kind: PillKind.outline;
                                    clicked => { root.open-editor(index); }
                                }
                                PillButton {
                                    text: "Avvia";
                                    clicked => { root.select(index); }
                                    PlayIcon { width: 20px; height: 20px; tint: parent.foreground; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Outside the scrolling viewport so the first row's tooltip is not clipped.
    if root.tooltip.visible && !root.loading && root.error == ""
        && root.tooltip-index >= 0 && root.tooltip-index < root.meetings.length
        && root.tooltip-meeting == root.meetings[root.tooltip-index]
        && root.tooltip.top >= meeting-list.absolute-position.y
        && root.tooltip.top < meeting-list.absolute-position.y + meeting-list.height : DailyTooltip {
        tip: root.tooltip;
        x: root.tooltip.right - root.absolute-position.x - self.width;
        y: root.tooltip.top - root.absolute-position.y - self.height - 4px;
    }
}

// One fixed-width cell of the countdown, so the digits never shift while they tick.
// Text clips to its box, so a cell must stay wider than its glyph. Manrope Bold digits are at
// most 0.52 em wide, which leaves a gap inside the 0.6 em cell. The colon is raised to the
// middle of the digit height.
component ClockCell inherits Rectangle {
    in property <string> glyph;
    in property <bool> colon;
    in property <length> size;
    in property <color> tint;
    width: root.colon ? root.size * 0.28 : root.size * 0.6;
    height: root.size;
    Text {
        width: parent.width;
        height: parent.height;
        y: root.colon ? -root.size * 0.1 : 0px;
        text: root.glyph;
        font-family: "Manrope";
        font-size: root.size;
        font-weight: 700;
        color: root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// Countdown as MM:SS, or HH:MM:SS from one hour on. `size` shrinks to fit `max-width`.
component ClockText inherits Rectangle {
    in property <int> seconds;
    in property <length> size;
    in property <length> avail;
    in property <color> tint;
    private property <int> hours: floor(root.seconds / 3600);
    private property <int> minutes: mod(floor(root.seconds / 60), 60);
    private property <int> secs: mod(root.seconds, 60);
    private property <length> fitted: min(root.size, root.avail / (root.hours > 0 ? 4.3 : 2.8));
    height: root.fitted;
    horizontal-stretch: 1;

    accessible-role: text;
    accessible-label: root.hours > 0
        ? root.hours + ":" + (root.minutes < 10 ? "0" : "") + root.minutes + ":" + (root.secs < 10 ? "0" : "") + root.secs
        : (root.minutes < 10 ? "0" : "") + root.minutes + ":" + (root.secs < 10 ? "0" : "") + root.secs;

    HorizontalLayout {
        alignment: center;
        spacing: 0px;
        if root.hours > 0 : ClockCell { glyph: floor(root.hours / 10); size: root.fitted; tint: root.tint; }
        if root.hours > 0 : ClockCell { glyph: mod(root.hours, 10); size: root.fitted; tint: root.tint; }
        if root.hours > 0 : ClockCell { glyph: ":"; colon: true; size: root.fitted; tint: root.tint; }
        ClockCell { glyph: floor(root.minutes / 10); size: root.fitted; tint: root.tint; }
        ClockCell { glyph: mod(root.minutes, 10); size: root.fitted; tint: root.tint; }
        ClockCell { glyph: ":"; colon: true; size: root.fitted; tint: root.tint; }
        ClockCell { glyph: floor(root.secs / 10); size: root.fitted; tint: root.tint; }
        ClockCell { glyph: mod(root.secs, 10); size: root.fitted; tint: root.tint; }
    }
}

// Speaker time as MM:SS in fixed-width cells.
component MiniClock inherits HorizontalLayout {
    in property <int> seconds;
    in property <length> size;
    in property <color> tint;
    // Shows --:-- instead of the digits.
    in property <bool> dashes;
    private property <int> minutes: min(99, floor(root.seconds / 60));
    private property <int> secs: mod(root.seconds, 60);
    spacing: 0px;
    ClockCell { glyph: root.dashes ? "-" : floor(root.minutes / 10); size: root.size; tint: root.tint; }
    ClockCell { glyph: root.dashes ? "-" : mod(root.minutes, 10); size: root.size; tint: root.tint; }
    ClockCell { glyph: ":"; colon: true; size: root.size; tint: root.tint; }
    ClockCell { glyph: root.dashes ? "-" : floor(root.secs / 10); size: root.size; tint: root.tint; }
    ClockCell { glyph: root.dashes ? "-" : mod(root.secs, 10); size: root.size; tint: root.tint; }
}

component StopPill inherits PillButton {
    text: "Stop";
    kind: PillKind.outline;
    StopIcon {
        width: root.compact ? 12px : 16px;
        height: root.compact ? 12px : 16px;
        tint: parent.foreground;
    }
}

component StepButton inherits Rectangle {
    in property <bool> plus;
    in property <bool> enabled: true;
    in property <bool> compact;
    in property <string> label;
    callback clicked();
    forward-focus: focus;
    width: root.compact ? 26px : 42px;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    FadeFill {
        width: parent.width;
        height: parent.height;
        target: touch.has-hover && root.enabled ? AppTheme.orange-soft : AppTheme.orange-soft.transparentize(1);
    }
    StepIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.compact ? 14px : 24px;
        height: root.compact ? 14px : 24px;
        plus: root.plus;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (!root.enabled) { return reject; }
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if focus.has-focus : FocusRing { host-width: root.width; host-height: root.height; corner-radius: 4px; }
}

// Pill with a minus and a plus button around the children.
component Stepper inherits Rectangle {
    in property <bool> compact;
    in property <bool> can-minus: true;
    in property <bool> can-plus: true;
    in property <string> minus-label;
    in property <string> plus-label;
    callback minus();
    callback plus();
    height: root.compact ? 30px : 46px;
    border-radius: self.height / 2;
    background: AppTheme.page;
    clip: true;
    preferred-width: row.preferred-width;
    min-width: row.min-width;
    horizontal-stretch: 0;

    row := HorizontalLayout {
        StepButton {
            compact: root.compact;
            enabled: root.can-minus;
            label: root.minus-label;
            clicked => { root.minus(); }
        }
        @children
        StepButton {
            plus: true;
            compact: root.compact;
            enabled: root.can-plus;
            label: root.plus-label;
            clicked => { root.plus(); }
        }
    }
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: self.height / 2;
        border-width: 2px;
        border-color: AppTheme.orange-tint;
    }
}

// Round soft button; the icon is a child sized by `icon-size` and colored by `icon-color`.
component SoftRoundButton inherits Rectangle {
    in property <bool> compact;
    in property <bool> enabled: true;
    in property <string> label;
    out property <length> icon-size: root.compact ? 14px : 22px;
    out property <color> icon-color: touch.has-hover && root.enabled ? #FFFFFF : AppTheme.orange;
    callback clicked();
    forward-focus: focus;
    width: root.compact ? 30px : 46px;
    height: root.compact ? 30px : 46px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    FadeFill {
        width: parent.width;
        height: parent.height;
        border-radius: self.height / 2;
        target: touch.has-hover && root.enabled ? AppTheme.orange : AppTheme.orange-tint;
    }
    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            @children
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if focus.has-focus : FocusRing { host-width: root.width; host-height: root.height; corner-radius: root.height / 2; }
}

// Participant dropdown: a pill that opens a list in a popup.
component TurnSelect inherits Rectangle {
    in property <[string]> names;
    in property <int> selected;
    in property <bool> compact;
    callback picked(int);
    private property <length> item-height: root.compact ? 28px : 40px;
    private property <int> highlight;
    private property <string> current: root.selected >= 0 && root.selected < root.names.length ? root.names[root.selected] : "";
    forward-focus: focus;
    height: root.compact ? 30px : 46px;
    min-width: root.compact ? 104px : 170px;
    max-width: root.compact ? 124px : 200px;
    preferred-width: root.compact ? 124px : 200px;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: AppTheme.page;

    accessible-role: combobox;
    accessible-label: "Partecipante";
    accessible-value: root.current;
    accessible-action-default => { popup.show(); }

    function open() {
        root.highlight = root.selected;
        popup.show();
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: self.height / 2;
        border-width: 2px;
        border-color: AppTheme.orange-tint;
    }
    Text {
        x: root.compact ? 10px : 14px;
        width: parent.width - (root.compact ? 34px : 52px);
        height: parent.height;
        text: root.current;
        font-size: root.compact ? 12px : 16px;
        font-weight: 400;
        color: AppTheme.text;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    ChevronIcon {
        x: parent.width - (root.compact ? 8px : 14px) - self.width;
        y: (parent.height - self.height) / 2;
        width: root.compact ? 14px : 18px;
        height: root.compact ? 14px : 18px;
    }
    touch := TouchArea { clicked => { root.open(); } }
    focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.DownArrow) {
                if (root.selected < root.names.length - 1) { root.picked(root.selected + 1); }
                return accept;
            }
            if (event.text == Key.UpArrow) {
                if (root.selected > 0) { root.picked(root.selected - 1); }
                return accept;
            }
            if (event.text == Key.Space || event.text == Key.Return) {
                root.open();
                return accept;
            }
            return reject;
        }
    }
    if focus.has-focus : FocusRing { host-width: root.width; host-height: root.height; corner-radius: root.height / 2; }

    popup := PopupWindow {
        forward-focus: keys;
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: min(root.names.length, 6) * root.item-height + 12px;
        Rectangle {
            background: AppTheme.page;
            border-radius: AppTheme.radius-item;
            border-width: 1px;
            border-color: AppTheme.border-subtle;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #1E1A2629;
            keys := FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.DownArrow) {
                        root.highlight = min(root.highlight + 1, root.names.length - 1);
                        return accept;
                    }
                    if (event.text == Key.UpArrow) {
                        root.highlight = max(root.highlight - 1, 0);
                        return accept;
                    }
                    if (event.text == Key.Return) {
                        root.picked(root.highlight);
                        popup.close();
                        return accept;
                    }
                    if (event.text == Key.Escape) {
                        popup.close();
                        return accept;
                    }
                    return reject;
                }
                ListView {
                    x: 6px;
                    y: 6px;
                    width: parent.width - 12px;
                    height: parent.height - 12px;
                    for name[i] in root.names : Rectangle {
                        height: root.item-height;
                        border-radius: root.compact ? 8px : AppTheme.radius-item;
                        background: item-touch.has-hover || i == root.highlight ? AppTheme.surface : #FFFFFF00;
                        accessible-role: list-item;
                        accessible-label: name;
                        Text {
                            x: root.compact ? 8px : 12px;
                            width: parent.width - 2 * self.x;
                            height: parent.height;
                            text: name;
                            font-size: root.compact ? 12px : 15px;
                            font-weight: 400;
                            color: AppTheme.text;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-role: none;
                        }
                        item-touch := TouchArea { clicked => { root.picked(i); } }
                    }
                }
            }
        }
    }
}

// Turn settings: who speaks, for how long, and the start button.
component TurnBar inherits Rectangle {
    in property <bool> compact;
    in property <[string]> names;
    in property <int> selected;
    in property <int> minutes;
    in property <int> max-minutes;
    callback picked(int);
    callback minutes-delta(int);
    callback start();
    background: AppTheme.orange-soft;
    border-radius: root.compact ? 12px : AppTheme.radius-card;
    preferred-width: row.preferred-width;
    min-width: row.min-width;
    horizontal-stretch: 0;

    row := HorizontalLayout {
        padding: root.compact ? 6px : 16px;
        padding-left: root.compact ? 8px : 16px;
        padding-right: root.compact ? 8px : 16px;
        spacing: root.compact ? 6px : 12px;
        alignment: center;
        TurnSelect {
            compact: root.compact;
            names: root.names;
            selected: root.selected;
            picked(index) => { root.picked(index); }
        }
        Stepper {
            compact: root.compact;
            can-minus: root.minutes > 1;
            can-plus: root.minutes < root.max-minutes;
            minus-label: "Meno un minuto";
            plus-label: "Più un minuto";
            minus => { root.minutes-delta(-1); }
            plus => { root.minutes-delta(1); }
            Rectangle {
                min-width: root.compact ? 34px : 46px;
                HorizontalLayout {
                    alignment: center;
                    spacing: 2px;
                    padding-left: 2px;
                    padding-right: 2px;
                    Text {
                        text: root.minutes;
                        font-size: root.compact ? 12px : 16px;
                        font-weight: 400;
                        color: AppTheme.text;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "min";
                        font-size: root.compact ? 10px : 13px;
                        font-weight: 400;
                        color: AppTheme.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }
        }
        SoftRoundButton {
            compact: root.compact;
            label: "Avvia il turno";
            clicked => { root.start(); }
            PlayIcon { width: parent.icon-size; height: parent.icon-size; tint: parent.icon-color; }
        }
    }
}

// Speaker bar: name, remaining time with one minute steps, and the buttons given as children.
// While `paused` the name and time are dimmed and a badge sits on the top edge.
component PersonBar inherits Rectangle {
    in property <bool> compact;
    in property <string> speaker;
    in property <duration> left;
    in property <bool> can-add;
    in property <bool> can-remove;
    in property <bool> dashes;
    in property <bool> paused;
    in property <duration> warn-under: 60s;
    in property <length> name-max: 260px;
    callback time-delta(int);
    background: AppTheme.orange-soft;
    border-radius: root.compact ? 12px : AppTheme.radius-card;
    preferred-width: row.preferred-width;
    min-width: row.min-width;
    horizontal-stretch: 0;
    private property <int> seconds: max(0, ceil(root.left / 1s));

    row := HorizontalLayout {
        padding-top: root.compact ? 6px : 12px;
        padding-bottom: root.compact ? 6px : 12px;
        padding-left: root.compact ? 8px : 16px;
        padding-right: root.compact ? 8px : 16px;
        spacing: root.compact ? 6px : 12px;
        alignment: center;
        Text {
            width: min(self.preferred-width, root.name-max);
            text: root.speaker;
            font-size: root.compact ? 13px : 18px;
            font-weight: 400;
            color: AppTheme.text;
            vertical-alignment: center;
            overflow: elide;
            opacity: root.paused ? 0.45 : 1;
        }
        Stepper {
            compact: root.compact;
            can-minus: root.can-remove;
            can-plus: root.can-add;
            minus-label: "Togli un minuto";
            plus-label: "Aggiungi un minuto";
            minus => { root.time-delta(-1); }
            plus => { root.time-delta(1); }
            Rectangle {
                min-width: root.compact ? 50px : 66px;
                opacity: root.paused ? 0.45 : 1;
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        MiniClock {
                            seconds: root.seconds;
                            dashes: root.dashes;
                            size: root.compact ? 13px : 18px;
                            tint: root.left < root.warn-under && !root.dashes ? AppTheme.orange : AppTheme.text;
                        }
                    }
                }
            }
        }
        @children
    }
    if root.paused : Rectangle {
        x: (root.width - self.width) / 2;
        y: root.compact ? -8px : -12px;
        width: badge-text.preferred-width + (root.compact ? 14px : 20px);
        height: badge-text.preferred-height + (root.compact ? 4px : 8px);
        border-radius: self.height / 2;
        background: AppTheme.danger;
        badge-text := Text {
            text: "IN PAUSA";
            font-size: root.compact ? 9px : 11px;
            font-weight: 400;
            letter-spacing: root.compact ? 0.72px : 0.88px;
            color: AppTheme.on-danger;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }
}

// Countdown screen with its three views: plain, turn settings and running turn.
component TimerPage inherits Rectangle {
    in property <duration> timer-time;
    in property <bool> running-state;
    in property <string> timer-end;
    in property <bool> turn-available;
    in property <TurnView> turn-view;
    in property <[string]> turn-names;
    in property <int> turn-selected;
    in property <int> turn-minutes;
    in property <int> turn-max-minutes;
    in property <string> turn-speaker;
    in property <duration> turn-left;
    in property <bool> turn-can-add;
    in property <string> daily-name;
    in property <string> daily-short-name;
    in property <duration> daily-left;
    in property <bool> daily-paused;
    in property <bool> daily-finished;
    in property <bool> daily-can-add;
    in property <bool> daily-can-remove;
    in property <string> daily-remaining;
    in property <[string]> daily-chips;
    callback stop(StopType);
    callback tick();
    callback show-turns();
    callback hide-turns();
    callback select-turner(int);
    callback adjust-turn-minutes(int);
    callback start-turn();
    callback adjust-turn-time(int);
    callback end-turn();
    callback toggle-daily-pause();
    callback next-daily-speaker();
    callback adjust-daily-time(int);
    // Compact rules below about 560px of width, large rules above.
    private property <bool> compact: root.width < 560px;
    private property <length> side: root.compact ? 16px : 32px;
    private property <bool> plain: root.turn-view == TurnView.Plain;

    Timer {
        interval: 0.25s;
        running: root.running-state;
        triggered => { if (root.running-state) { root.tick(); } }
    }

    VerticalLayout {
        padding-left: root.side;
        padding-right: root.side;
        padding-top: root.compact ? 12px : 32px;
        padding-bottom: root.compact ? 12px : 40px;
        alignment: center;
        spacing: root.plain ? 0px : (root.compact ? 8px : 24px);
        ClockText {
            seconds: max(0, ceil(root.timer-time / 1s));
            size: root.compact && !root.plain ? 54px : (root.compact ? 84px : clamp(72px, root.width * 0.16, 160px));
            avail: root.width - 2 * root.side;
            tint: root.timer-time < 150s ? AppTheme.orange : AppTheme.timer-title;
        }
        if root.plain : Rectangle { height: root.compact ? 4px : 12px; }
        if root.plain : Text {
            text: "Fine alle " + root.timer-end;
            font-size: root.compact ? 13px : 19px;
            color: AppTheme.text-secondary;
            horizontal-alignment: center;
        }
        if root.plain : Rectangle {
            min-height: root.compact ? 24px : 16px;
            max-height: root.compact ? 32px : 112px;
            vertical-stretch: 1;
        }
        if root.turn-view == TurnView.Settings : HorizontalLayout {
            alignment: center;
            TurnBar {
                compact: root.compact;
                names: root.turn-names;
                selected: root.turn-selected;
                minutes: root.turn-minutes;
                max-minutes: root.turn-max-minutes;
                picked(index) => { root.select-turner(index); }
                minutes-delta(delta) => { root.adjust-turn-minutes(delta); }
                start => { root.start-turn(); }
            }
        }
        if root.turn-view == TurnView.Running : HorizontalLayout {
            alignment: center;
            PersonBar {
                compact: root.compact;
                speaker: root.turn-speaker;
                left: root.turn-left;
                can-add: root.turn-can-add;
                can-remove: root.turn-left > 0s;
                name-max: root.compact ? 92px : 260px;
                time-delta(delta) => { root.adjust-turn-time(delta); }
                SoftRoundButton {
                    compact: root.compact;
                    label: "Fine turno";
                    clicked => { root.end-turn(); }
                    StopIcon { width: parent.icon-size; height: parent.icon-size; tint: parent.icon-color; }
                }
            }
        }
        if root.turn-view == TurnView.Daily : HorizontalLayout {
            alignment: center;
            VerticalLayout {
                spacing: root.compact ? 6px : 12px;
                horizontal-stretch: 0;
                PersonBar {
                    compact: root.compact;
                    speaker: root.compact ? root.daily-short-name : root.daily-name;
                    left: root.daily-left;
                    can-add: root.daily-can-add;
                    can-remove: root.daily-can-remove;
                    dashes: root.daily-finished;
                    paused: root.daily-paused;
                    warn-under: 30s;
                    name-max: root.compact ? 84px : 260px;
                    time-delta(delta) => { root.adjust-daily-time(delta); }
                    SoftRoundButton {
                        compact: root.compact;
                        enabled: !root.daily-finished;
                        label: root.daily-paused ? "Riprendi" : "Pausa";
                        clicked => { root.toggle-daily-pause(); }
                        if root.daily-paused : PlayIcon { width: parent.icon-size; height: parent.icon-size; tint: parent.icon-color; }
                        if !root.daily-paused : PauseIcon { width: parent.icon-size; height: parent.icon-size; tint: parent.icon-color; }
                    }
                    SoftRoundButton {
                        compact: root.compact;
                        enabled: !root.daily-finished;
                        label: "Passa la parola";
                        clicked => { root.next-daily-speaker(); }
                        SkipIcon { width: parent.icon-size; height: parent.icon-size; tint: parent.icon-color; }
                    }
                }
                if !root.compact : Rectangle {
                    height: 28px;
                    clip: true;
                    min-width: 0px;
                    preferred-width: 0px;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        for chip in root.daily-chips : Rectangle {
                            width: chip-text.preferred-width + 22px;
                            height: 26px;
                            border-radius: 13px;
                            background: AppTheme.page;
                            border-width: 1px;
                            border-color: AppTheme.border-subtle;
                            chip-text := Text {
                                x: 11px;
                                width: parent.width - 22px;
                                height: parent.height;
                                text: chip;
                                font-size: 12px;
                                font-weight: 400;
                                color: AppTheme.text-secondary;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
                if root.compact && root.daily-remaining != "" : Text {
                    text: root.daily-remaining;
                    font-size: 12px;
                    color: AppTheme.text-secondary;
                    horizontal-alignment: center;
                }
            }
        }
        if root.turn-view == TurnView.Daily && !root.compact : Rectangle { height: 16px; }
        HorizontalLayout {
            alignment: center;
            spacing: 12px;
            if root.plain && root.turn-available : PillButton {
                text: root.compact ? "Turni" : "Turni di parola";
                kind: PillKind.outline;
                compact: root.compact;
                clicked => { root.show-turns(); }
                PeopleIcon {
                    width: root.compact ? 12px : 16px;
                    height: root.compact ? 12px : 16px;
                    tint: parent.foreground;
                }
            }
            if root.turn-view == TurnView.Settings : PillButton {
                text: "Nascondi";
                kind: PillKind.outline;
                compact: root.compact;
                clicked => { root.hide-turns(); }
                EyeOffIcon {
                    width: root.compact ? 12px : 16px;
                    height: root.compact ? 12px : 16px;
                    tint: parent.foreground;
                }
            }
            StopPill {
                compact: root.compact;
                clicked => { root.stop(StopType.UserStopped); }
            }
        }
    }
}

component ConfettiPiece inherits Rectangle {
    in property <int> index;
    in property <duration> elapsed;
    in property <duration> delay;
    in property <length> area-width;
    in property <length> area-height;
    in property <color> tint;
    pure function rnd(k: int) -> float {
        let v = sin((root.index * 12.9898 + k * 78.233) * 1rad) * 43758.5453;
        return v - floor(v);
    }
    // Frames at 60 per second since the piece was thrown.
    private property <float> n: max(0, (root.elapsed - root.delay) / 1ms * 0.06);
    private property <float> vx: (rnd(1) - 0.5) * 14;
    private property <float> vy: -rnd(2) * 13 - 4;
    private property <length> px: root.area-width / 2 + (rnd(3) - 0.5) * root.area-width * 0.3
        + root.vx * (1 - pow(0.985, root.n)) / 0.015 * 1px;
    private property <length> py: root.area-height * 0.45 + (root.vy * root.n + 0.175 * root.n * (root.n + 1)) * 1px;
    private property <float> fade: clamp(1 - (root.py - root.area-height * 0.9) / (root.area-height * 0.1 + 40px), 0, 1);
    x: root.px;
    y: root.py;
    width: (6 + rnd(4) * 6) * 1px;
    height: (8 + rnd(5) * 8) * 1px;
    background: root.tint;
    opacity: root.fade;
    visible: root.elapsed >= root.delay && root.fade > 0;
    transform-rotation: (rnd(6) * 3.14159 + (rnd(7) - 0.5) * 0.3 * root.n) * 57.2958deg;
}

// "Meeting terminato!" with rotating captions and confetti.
component FinishedPage inherits Rectangle {
    in property <int> seed;
    callback home();
    private property <bool> compact: root.width < 560px;
    private property <length> side: root.compact ? 16px : 32px;
    private property <[string]> captions: [
        "Finalmente.",
        "Poteva essere una mail. Ma ce l’abbiamo fatta.",
        "Nessun partecipante è stato maltrattato.",
        "GG. Si va a pranzo?",
        "Il countdown ha vinto, ancora una volta.",
        "Ultima slide? Non c’era nessuna slide.",
        "Mission accomplished (quella di finire in orario).",
        "Stand-up seduto, ma in orario.",
        "Le colonne hanno retto.",
    ];
    private property <int> current;
    private property <int> previous;
    private property <duration> started;
    private property <bool> settled;
    private property <duration> elapsed: root.settled ? 12s : animation-tick() - root.started;
    private property <float> pop: clamp(intro.value * 1100 / 700, 0, 1);
    private property <float> rise: clamp((intro.value * 1100 - 500) / 600, 0, 1);
    private property <float> swap-in: clamp((swap.value - 0.43) / 0.57, 0, 1);
    private property <float> swap-out: clamp(swap.value / 0.43, 0, 1);

    intro := MotionProgress { duration: 1100ms; }
    swap := MotionProgress { duration: 700ms; }

    init => {
        root.started = animation-tick();
        root.current = mod(root.seed, root.captions.length);
        root.previous = root.current;
        intro.restart();
    }
    Timer {
        interval: 2800ms;
        running: true;
        triggered => {
            root.previous = root.current;
            root.current = mod(root.current + 1, root.captions.length);
            swap.restart();
        }
    }
    Timer {
        interval: 12s;
        running: !root.settled;
        triggered => { root.settled = true; }
    }

    if !AppMotion.reduced : Rectangle {
        width: parent.width;
        height: parent.height;
        for i in 140 : ConfettiPiece {
            index: i;
            elapsed: root.elapsed;
            delay: 0ms;
            area-width: root.width;
            area-height: root.height;
            tint: i < 0 ? #000000 : (mod(i, 5) == 0 ? #6B2FBF : (mod(i, 5) == 1 ? #E07B00 : (mod(i, 5) == 2 ? #F6C453 : (mod(i, 5) == 3 ? #C9B3F0 : (AppTheme.dark ? #F3EFF9 : #1E1A26)))));
        }
        for i in 40 : ConfettiPiece {
            index: 200 + i;
            elapsed: root.elapsed;
            delay: 1800ms + i * 155ms;
            area-width: root.width;
            area-height: root.height;
            tint: mod(i, 5) == 0 ? #6B2FBF : (mod(i, 5) == 1 ? #E07B00 : (mod(i, 5) == 2 ? #F6C453 : (mod(i, 5) == 3 ? #C9B3F0 : (AppTheme.dark ? #F3EFF9 : #1E1A26))));
        }
    }

    VerticalLayout {
        padding-left: root.side;
        padding-right: root.side;
        padding-top: root.compact ? 12px : 32px;
        padding-bottom: root.compact ? 12px : 40px;
        alignment: center;
        spacing: root.compact ? 8px : 24px;
        Text {
            text: "Meeting terminato!";
            font-size: root.compact ? 30px : clamp(34px, root.width * 0.06, 56px);
            font-weight: 400;
            letter-spacing: -0.03 * self.font-size;
            color: AppTheme.text-brand;
            horizontal-alignment: center;
            wrap: word-wrap;
            opacity: root.pop < 0.6 ? root.pop / 0.6 : 1;
            transform-scale: root.pop < 0.6 ? 0.4 + 0.68 * (root.pop / 0.6) : 1.08 - 0.08 * ((root.pop - 0.6) / 0.4);
            transform-rotation: (root.pop < 0.6 ? -6 + 8 * (root.pop / 0.6) : 2 - 2 * ((root.pop - 0.6) / 0.4)) * 1deg;
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: min(340px, root.width - 2 * root.side);
                height: root.compact ? 34px : 54px;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.captions[swap.active && swap.value < 0.43 ? root.previous : root.current];
                    font-size: root.compact ? 12px : 18px;
                    font-weight: 400;
                    color: AppTheme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    opacity: swap.active ? (swap.value < 0.43 ? 1 - root.swap-out : root.swap-in) : 1;
                    y: swap.active ? (swap.value < 0.43 ? -8px * root.swap-out : 8px * (1 - root.swap-in)) : 0px;
                }
            }
        }
        Rectangle { height: 16px; }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: home-button.preferred-width;
                height: home-button.preferred-height;
                home-button := PillButton {
                    width: parent.width;
                    height: parent.height;
                    y: (1 - root.rise) * 12px;
                    opacity: root.rise;
                    text: "Torna alla home";
                    kind: PillKind.outline;
                    compact: root.compact;
                    clicked => { root.home(); }
                    HomeIcon {
                        width: root.compact ? 12px : 16px;
                        height: root.compact ? 12px : 16px;
                        tint: parent.foreground;
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Schisaciaccole";
    background: AppTheme.page;
    icon: @image-url("../assets/icon_256.png");
    preferred-width: 880px;
    min-width: root.timer-mode ? 360px : 800px;
    preferred-height: 660px;
    min-height: root.timer-mode ? 240px : 600px;
    default-font-family: "Momo Trust Display";
    forward-focus: scope;

    in-out property <bool> on-top: false;
    always-on-top: on-top;
    // True while a countdown screen shows; allows the small window.
    in property <bool> timer-mode: false;

    in-out property <bool> reduce-motion <=> AppMotion.reduced;
    page-fade := MotionProgress { duration: 180ms; }

    in property <string> current-time;
    in property <string> timer-end;
    in property <int> finish-seed;
    in property <bool> turn-available;
    in property <TurnView> turn-view;
    in property <[string]> turn-names;
    in property <int> turn-selected;
    in property <int> turn-minutes;
    in property <int> turn-max-minutes;
    in property <string> turn-speaker;
    in property <duration> turn-left;
    in property <bool> turn-can-add;
    in property <string> daily-name;
    in property <string> daily-short-name;
    in property <duration> daily-left;
    in property <bool> daily-paused;
    in property <bool> daily-finished;
    in property <bool> daily-can-add;
    in property <bool> daily-can-remove;
    in property <string> daily-remaining;
    in property <[string]> daily-chips;

    in property     <duration> timer-time: 3s;
    in property     <bool>     running-state: false;
    in property     <Page>     page: Page.ManualPage;
    in property     <[TimeOption]> options;
    in property     <int>      selected-slot: -1;
    in property     <bool>     is-macos;
    in property     <bool>     signed-in;
    in property     <string>   account-name;
    in property     <string>   notice;
    in property     <string>   login-status;
    in property     <bool>     login-waiting;
    in property     <[MeetingRow]> meetings;
    in property     <bool>     meetings-loading;
    in property     <string>   meetings-error;

    in property     <[EditorRow]> editor-rows;
    in property     <string>   editor-title;
    in property     <string>   editor-time-range;
    in property     <string>   editor-duration;
    in property     <bool>     editor-attendees-warning;
    in property     <bool>     editor-groups-reconnect;
    in property     <bool>     groups-reconnect;
    in property     <bool>     editor-busy;
    in property     <string>   editor-notice;
    in property     <bool>     editor-has-preference;
    in property     <bool>     editor-daily-start;

    callback open-editor(int);
    callback editor-set-label(int, string);
    callback editor-set-included(int, bool);
    callback editor-remove-row(int);
    callback editor-add-row();
    callback editor-reset-participants();
    callback editor-save();
    callback editor-delete();
    callback editor-start();
    callback editor-back();

    callback select-slot(int);
    callback start-selected();
    callback compute-options();
    callback tick();
    callback set-manual-page();
    callback quit();
    callback fullscreen(bool);
    callback help();
    callback stop(StopType);
    callback login();
    callback cancel-login();
    callback skip-login();
    callback select-meeting(int);
    callback refresh-meetings();
    callback set-meetings-page();
    callback close-finished();
    callback logout();
    callback show-turns();
    callback hide-turns();
    callback select-turner(int);
    callback adjust-turn-minutes(int);
    callback start-turn();
    callback adjust-turn-time(int);
    callback end-turn();
    callback set-daily(int, bool);
    callback toggle-daily-pause();
    callback next-daily-speaker();
    callback adjust-daily-time(int);

    changed page => { page-fade.restart(); scope.focus(); }

    if is-macos: MenuBar {
	Menu {
	    title: @tr("Window");
	    MenuItem {
		title: @tr("Always on top");
		activated => { on-top = !on-top; }
		shortcut: @keys(Control + T);
	    }
	}
	Menu {
	    title: "Account";
	    if signed-in: MenuItem {
		title: "Esci dall'account";
		activated => { logout(); }
	    }
	}
    }

    scope := FocusScope {
        KeyBinding {
            keys: @keys(Q);
            activated => { quit(); }
        }

        KeyBinding {
            keys: @keys(M);
            activated => { fullscreen(false); }
        }

        KeyBinding {
            keys: @keys(Escape);
            activated => { fullscreen(true); }
        }

        KeyBinding {
            keys: @keys(T);
            activated => { on-top = !on-top; }
        }

        KeyBinding {
            keys: @keys(H);
            activated => { help(); }
        }

        page-body := Rectangle {
            width: root.width;
            height: root.height;
            opacity: page-fade.value;
            if page == Page.ManualPage || page == Page.MeetingsPage : VerticalLayout {
                Navigation {
                    meetings-page: root.page == Page.MeetingsPage;
                    signed-in: root.signed-in;
                    manual => { root.set-manual-page(); }
                    meetings => {
                        if (root.page == Page.MeetingsPage) {
                            root.refresh-meetings();
                        } else {
                            root.set-meetings-page();
                        }
                    }
                    logout => { root.logout(); }
                }
                if page == Page.ManualPage : ManualPage {
                    current-time: root.current-time;
                    options: root.options;
                    selected-slot: root.selected-slot;
                    notice: root.notice;
                    select-slot(index) => { root.select-slot(index); }
                    start-timer => { root.start-selected(); }
                }
                if page == Page.MeetingsPage : MeetingsPage {
                    account-name: root.account-name;
                    meetings: root.meetings;
                    loading: root.meetings-loading;
                    error: root.meetings-error;
                    groups-reconnect: root.groups-reconnect;
                    login-waiting: root.login-waiting;
                    login-status: root.login-status;
                    reconnect => { root.login(); }
                    cancel-login => { root.cancel-login(); }
                    select(index) => { root.select-meeting(index); }
                    open-editor(index) => { root.open-editor(index); }
                    set-daily(index, on) => { root.set-daily(index, on); }
                    refresh => { root.refresh-meetings(); }
                }
            }
            if page == Page.EditorPage : EditorPage {
                width: root.width;
                height: root.height;
                title: root.editor-title;
                time-range: root.editor-time-range;
                duration: root.editor-duration;
                attendees-warning: root.editor-attendees-warning;
                groups-reconnect: root.editor-groups-reconnect;
                login-waiting: root.login-waiting;
                login-status: root.login-status;
                reconnect => { root.login(); }
                cancel-login => { root.cancel-login(); }
                busy: root.editor-busy;
                notice: root.editor-notice;
                has-preference: root.editor-has-preference;
                daily-start: root.editor-daily-start;
                rows: root.editor-rows;
                set-label(index, text) => { root.editor-set-label(index, text); }
                set-included(index, included) => { root.editor-set-included(index, included); }
                remove-row(index) => { root.editor-remove-row(index); }
                add-row => { root.editor-add-row(); }
                reset-participants => { root.editor-reset-participants(); }
                save => { root.editor-save(); }
                delete-preference => { root.editor-delete(); }
                start-meeting => { root.editor-start(); }
                back => { root.editor-back(); }
            }
            if page == Page.LoadingPage : VerticalLayout {
                padding: 32px;
                alignment: center;
                spacing: 16px;
                HorizontalLayout {
                    alignment: center;
                    BrandMark { width: 64px; height: 64px; }
                }
                PageTitle { text: "Connessione…"; horizontal-alignment: center; }
                PageSub { text: "Prepariamo i tuoi meeting."; horizontal-alignment: center; }
            }
            if page == Page.LoginPage : VerticalLayout {
                padding: 48px;
                spacing: 20px;
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    BrandMark { width: 64px; height: 64px; }
                }
                PageTitle { text: "Accedi con Google"; horizontal-alignment: center; }
                PageSub {
                    text: "I tuoi meeting di oggi, con un tempo per ogni voce.";
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    padding-top: 8px;
                    alignment: center;
                    spacing: 16px;
                    if !root.login-waiting : PillButton {
                        text: "Accedi con Google";
                        clicked => { root.login(); }
                    }
                    if !root.login-waiting : PillButton {
                        text: "Usa senza accesso";
                        kind: PillKind.ghost;
                        clicked => { root.skip-login(); }
                    }
                    if root.login-waiting : PillButton {
                        text: "Annulla";
                        kind: PillKind.ghost;
                        clicked => { root.cancel-login(); }
                    }
                }
                AppText {
                    text: root.login-status;
                    color: AppTheme.notice;
                    font-size: 15px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
            if page == Page.TimerPage : TimerPage {
                width: root.width;
                height: root.height;
                timer-time: root.timer-time;
                running-state: root.running-state;
                timer-end: root.timer-end;
                turn-available: root.turn-available;
                turn-view: root.turn-view;
                turn-names: root.turn-names;
                turn-selected: root.turn-selected;
                turn-minutes: root.turn-minutes;
                turn-max-minutes: root.turn-max-minutes;
                turn-speaker: root.turn-speaker;
                turn-left: root.turn-left;
                turn-can-add: root.turn-can-add;
                show-turns => { root.show-turns(); }
                hide-turns => { root.hide-turns(); }
                select-turner(index) => { root.select-turner(index); }
                adjust-turn-minutes(delta) => { root.adjust-turn-minutes(delta); }
                start-turn => { root.start-turn(); }
                adjust-turn-time(delta) => { root.adjust-turn-time(delta); }
                end-turn => { root.end-turn(); }
                daily-name: root.daily-name;
                daily-short-name: root.daily-short-name;
                daily-left: root.daily-left;
                daily-paused: root.daily-paused;
                daily-finished: root.daily-finished;
                daily-can-add: root.daily-can-add;
                daily-can-remove: root.daily-can-remove;
                daily-remaining: root.daily-remaining;
                daily-chips: root.daily-chips;
                toggle-daily-pause => { root.toggle-daily-pause(); }
                next-daily-speaker => { root.next-daily-speaker(); }
                adjust-daily-time(delta) => { root.adjust-daily-time(delta); }
                stop(stop-type) => { root.stop(stop-type); }
                tick => { root.tick(); }
            }
            if page == Page.TimerFinished : FinishedPage {
                width: root.width;
                height: root.height;
                seed: root.finish-seed;
                home => { root.close-finished(); }
            }
        }
    }

    compute-options-timer := Timer {
	interval  : 3s;
	running: !running-state;

	triggered() => {
	    // when the main timer is stopped keep updating the selection
	    compute-options();
	}
    }

    if on-top : Rectangle {
        width: 8px;
        height: 8px;
        x: root.width - 12px;
        y: 4px;
        background: AppTheme.orange;
        border-radius: 4px;
    }
}

component KeyChip inherits Rectangle {
    in property <string> key;
    width: 64px;
    height: 36px;
    border-radius: AppTheme.radius-item;
    background: AppTheme.surface;
    Text {
        text: root.key;
        color: AppTheme.text-brand;
        font-size: 16px;
        font-weight: 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Help inherits Window {
    title: "Schisaciaccole · Scorciatoie";
    background: AppTheme.page;
    preferred-width: 640px;
    preferred-height: 440px;
    min-width: 600px;
    min-height: 420px;
    always-on-top: true;
    default-font-family: "Momo Trust Display";

    VerticalLayout {
        padding: 32px;
        spacing: 20px;
        PageTitle { text: "Scorciatoie da tastiera"; font-size: 28px; letter-spacing: -0.56px; }
        GridLayout {
            spacing-horizontal: 24px;
            spacing-vertical: 12px;
            Row { KeyChip { key: "Q"; } AppText { text: "Esci dall’app"; font-size: 16px; vertical-alignment: center; } }
            Row { KeyChip { key: "M"; } AppText { text: "Attiva o disattiva lo schermo intero"; font-size: 16px; vertical-alignment: center; } }
            Row { KeyChip { key: "Esc"; } AppText { text: "Esci dallo schermo intero"; font-size: 16px; vertical-alignment: center; } }
            Row { KeyChip { key: "T"; } AppText { text: "Mantieni la finestra in primo piano"; font-size: 16px; vertical-alignment: center; } }
            Row { KeyChip { key: "H"; } AppText { text: "Mostra le scorciatoie"; font-size: 16px; vertical-alignment: center; } }
        }
        AboutSlint { height: 50px; }
    }
}
