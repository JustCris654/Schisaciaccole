# Copy to .env and fill in. .env is git-ignored: never commit real secrets.

# Address the server listens on (default 0.0.0.0:8080).
BIND_ADDR=0.0.0.0:8080

# PostgreSQL URL. This value is for local development (docker compose up -d db);
# in docker compose the server service overrides it to point to the db service.
DATABASE_URL=postgres://schisaciaccole:schisaciaccole@localhost:5432/schisaciaccole

# Public URL of the server, no trailing slash (used for the OAuth redirect URI).
PUBLIC_BASE_URL=https://schisaciaccole.example.com

# Google OAuth client credentials (Google Cloud Console).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Google Workspace domain allowed to log in (hd claim).
ALLOWED_HD=example.com

# Key encrypting stored Google tokens: base64, exactly 32 bytes.
# Generate with: openssl rand -base64 32
TOKEN_ENC_KEY=replace-with-openssl-rand-base64-32

# Key signing the server's JWTs: at least 32 bytes.
# Generate with: openssl rand -base64 32
JWT_SIGNING_KEY=replace-with-openssl-rand-base64-32

# Optional overrides (defaults shown).
# GOOGLE_ISSUER_URL=https://accounts.google.com
# GOOGLE_CALENDAR_BASE_URL=https://www.googleapis.com/calendar/v3
# GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar.events.owned.readonly

# Reverse proxies in front of the server that append the client address to
# X-Forwarded-For: 0 when exposed directly (headers ignored), 1 behind one proxy.
# TRUSTED_PROXY_HOPS=0
